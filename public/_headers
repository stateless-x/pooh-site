# Read by Cloudflare when it serves dist/; it is not published as a file.
#
# Astro puts a content hash in every filename under /_astro/, so a changed file
# always gets a new URL and these can be cached for good. That includes the
# three.js chunk and the 3D model. HTML keeps the default revalidation, so a
# visitor always gets the page that points at the newest files.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare sends .txt files as text/plain with no charset, and a reader with
# no charset falls back to Latin-1. llms.txt is mostly Thai, so that fallback
# turns it into unreadable text.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
