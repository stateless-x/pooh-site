---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import { fixAiFaq, repairCategories } from "../data/fix-ai";
import { protectThai } from "../utils/thai";

const fitItems = [
	{
		title: "มีของจริงให้ตรวจ",
		body: "มีลิงก์ ไฟล์งาน หรือสิทธิ์เข้าดูส่วนที่มีปัญหา เพื่อให้ประเมินจากของจริงได้",
	},
	{
		title: "เป้าหมายของงานชัด",
		body: "รู้ว่าต้องการให้ลูกค้าหรือทีมทำอะไรบนเว็บ และบอกได้ว่าตอนนี้ติดอยู่ตรงไหน",
	},
	{
		title: "ยอมปรับเฉพาะส่วนที่จำเป็น",
		body: "เก็บของเดิมเมื่อยังใช้ได้ และพร้อมวางใหม่บางส่วนเมื่อการฝืนแก้ต่อเสี่ยงกว่าหรือไม่คุ้ม",
	},
] as const;

const notFitItems = [
	"ต้องการคนคอยเฝ้าระบบหรือแก้เหตุเร่งด่วนตลอดเวลา",
	"ไม่มีไฟล์ต้นฉบับ ไม่มีสิทธิ์เข้าถึง และส่งต่อของเดิมไม่ได้",
	"ระบบขนาดใหญ่ที่หลายส่วนพันกันจนยังแยกขอบเขตงานไม่ได้",
] as const;

const processSteps = [
	{
		n: "01",
		title: "ส่งของจริงมาให้ดู",
		body: "ส่งลิงก์ บอกเครื่องมือที่ใช้สร้าง และเล่าว่าตอนนี้ติดตรงไหน",
	},
	{
		n: "02",
		title: "ประเมินว่าควรแก้ต่อไหม",
		body: "ผมดูว่าอะไรเก็บได้ อะไรต้องวางใหม่ และตีกรอบเป็นงานที่ส่งมอบจบได้หรือไม่",
	},
	{
		n: "03",
		title: "ตกลงรายการก่อนลงมือ",
		body: "สรุปสิ่งที่แก้ สิ่งที่ไม่รวม และจุดที่ถือว่างานจบให้ตรงกันก่อนเริ่ม",
	},
	{
		n: "04",
		title: "แก้ ทดสอบ และส่งมอบ",
		body: "ทำตามรายการที่ตกลง ทดสอบส่วนสำคัญ และส่งมอบให้ครบตามขอบเขต งานใหม่ค่อยประเมินใหม่",
	},
] as const;

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: fixAiFaq.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "หน้าแรก",
			item: new URL("/", Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "รับแก้เว็บที่สร้างด้วย AI",
			item: new URL("/fix-ai-website/", Astro.site).href,
		},
	],
};
---

<Layout
	title="รับแก้เว็บที่สร้างด้วย AI ให้พร้อมใช้งาน | Pooh"
	description="เว็บที่สร้างด้วย AI เปิดไม่ได้ มือถือเพี้ยน ฟอร์มไม่ทำงาน หรือ SEO ยังไม่พร้อม ส่งลิงก์ให้ภูรินท์ประเมินก่อน รับเฉพาะงานที่ขอบเขตชัด"
	schema={[faqSchema, breadcrumb]}
>
	<section class="page-head band-cream">
		<div class="shell page-head-inner">
			<p class="label">เว็บดูเหมือนใกล้เสร็จ แต่ยังเปิดใช้จริงไม่ได้</p>
			<h1>รับแก้เว็บที่สร้างด้วย AI ให้พร้อมใช้งานจริง</h1>
			<p class="lede">
				<strong
					>ถ้าเว็บที่ทำด้วย AI ยังติดอยู่ไม่กี่จุด ผมช่วยตรวจและเก็บงานเฉพาะส่วนให้จบได้ครับ</strong
				> ผมขอดูของจริงก่อนทุกงาน แล้วสรุปว่าอะไรเก็บต่อได้ อะไรควรแก้
				และตีกรอบเป็นงานที่ส่งมอบจบได้หรือไม่ ถ้าแก้ต่อไม่คุ้มจะบอกตรง ๆ ก่อนเริ่ม
			</p>
			<div class="actions">
				<LineButton size="lg" label="ส่งลิงก์ให้ผมประเมินก่อน" />
			</div>
			<p class="head-note">ประเมินเบื้องต้นไม่มีค่าใช้จ่าย และยังไม่ผูกมัดว่าต้องจ้างทำ</p>
		</div>
	</section>

	<section class="section">
		<div class="shell repair-intro">
			<div class="prose reveal">
				<p>
					การเริ่มทำเว็บด้วย AI ไม่ใช่เรื่องผิดครับ ข้อดีคือเห็นหน้าตาและลองไอเดียได้เร็ว
					หลายงานจึงไม่ได้ต้องเริ่มใหม่ทั้งหมด แต่อาจต้องมีคนช่วยเก็บส่วนที่ AI ทำค้างไว้
					หรือส่วนที่มองจากหน้าจออย่างเดียวไม่เห็น
				</p>
				<p>
					จุดที่เจอมักซ้ำกันครับ เช่น เว็บเปิดจริงไม่ได้ มือถือเพี้ยน ฟอร์มกดแล้วข้อมูลไม่ไป
					เข้าใช้งานไม่ได้ เว็บช้า หรือ Google อ่านหน้าเว็บไม่ครบ
					ปัญหาเหล่านี้แยกเป็นงานจบได้ ถ้าของเดิมยังมีโครงที่ตามต่อได้
				</p>
				<p class="pullout">
					ผมรับแก้ต่อเมื่อของเดิมยังพอไปต่อ และตีกรอบงานให้จบชัดเจนได้
				</p>
				<p>
					ถ้าเปิดดูแล้วทุกส่วนพันกันจนแตะจุดหนึ่งกระทบอีกหลายจุด
					หรือไม่มีไฟล์และสิทธิ์ที่จำเป็น ผมจะไม่รับปากว่าจะซ่อมให้จบ
					แต่จะบอกตามตรงว่าควรหยุดแก้ของเดิม ปรับโครงบางส่วน หรือหาคนที่เหมาะกับงานมากกว่า
				</p>
			</div>

			<div class="repair-visual reveal reveal-d1">
				<ImagePlaceholder
					alt="ภาพตัวอย่างเว็บไซต์เดียวกันก่อนและหลังเก็บงาน แสดงทั้งหน้าจอมือถือและคอมพิวเตอร์"
					label="ภาพเปรียบเทียบก่อนและหลัง ใช้เว็บตัวอย่าง ไม่อ้างว่าเป็นผลงานลูกค้า"
					ratio="16 / 10"
					sizes="(min-width: 68rem) 32rem, (min-width: 48rem) 44vw, calc(100vw - 2.75rem)"
				/>
			</div>
		</div>
	</section>

	<section class="section band-tint">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">อาการที่รับช่วยเป็นจุด</p>
				<h2>ปัญหาที่มักเกิดซ้ำกับเว็บที่สร้างด้วย AI</h2>
				<p class="lede">
					แต่ละงานไม่จำเป็นต้องมีครบทุกข้อครับ เลือกแก้เฉพาะอาการที่ขวางการเปิดใช้จริง
					โดยตกลงรายการให้ชัดก่อนเริ่ม
				</p>
			</div>

			<div class="sheet reveal">
				<ol class="checklist">
					{
						repairCategories.map((item, i) => (
							<li class="check">
								<span class="check-n" aria-hidden="true">
									{String(i + 1).padStart(2, "0")}
								</span>
								<div class="check-body">
									<h3>{protectThai(item.title)}</h3>
									<p>{protectThai(item.body)}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">รับเฉพาะงานที่มีทางจบ</p>
				<h2>เช็กก่อนว่างานของคุณเหมาะกับบริการนี้ไหม</h2>
			</div>

			<div class="fit-grid">
				<div class="fit-card reveal">
					<p class="fit-kicker">เหมาะเมื่อ</p>
					<ul class="fit-list">
						{fitItems.map((item) => (
							<li>
								<strong>{protectThai(item.title)}</strong>
								<span>{protectThai(item.body)}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="fit-card is-muted reveal reveal-d1">
					<p class="fit-kicker">อาจไม่เหมาะเมื่อ</p>
					<ul class="not-fit-list">
						{notFitItems.map((item) => <li>{protectThai(item)}</li>)}
					</ul>
					<p class="fit-note">
						ถ้าไม่แน่ใจ ส่งมาให้ดูก่อนได้ครับ การบอกว่าไม่ควรแก้ต่อก็เป็นคำตอบที่ช่วยประหยัดเวลาและงบได้
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section band-cream">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">วิธีรับงาน</p>
				<h2>เริ่มจากตรวจ แล้วค่อยตกลงขอบเขตให้จบชัดเจน</h2>
			</div>

			<ol class="process-list">
				{processSteps.map((step, i) => (
					<li class:list={["process-item", "reveal", `reveal-d${i % 2}`]}>
						<span class="process-n">{step.n}</span>
						<div>
							<h3>{protectThai(step.title)}</h3>
							<p>{protectThai(step.body)}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="shell narrow">
			<div class="section-head reveal">
				<p class="label">คำถามที่เจอบ่อย</p>
				<h2>เรื่องที่คนถามก่อนส่งงานมาให้ดู</h2>
			</div>

			<div class="faq">
				{
					fixAiFaq.map((item, i) => (
						<details class:list={["faq-item", "reveal", `reveal-d${i % 3}`]}>
							<summary>
								<span class="faq-q">{protectThai(item.q)}</span>
								<span class="faq-sign" aria-hidden="true" />
							</summary>
							<p class="faq-a">{protectThai(item.a)}</p>
						</details>
					))
				}
			</div>

			<p class="more reveal">
				มีคำถามอื่นอีก ดู<a href="/contact">คำถามที่เจอบ่อยทั้งหมดในหน้าติดต่อ</a>
				หรือทักมาถามตรง ๆ ได้เลยครับ
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">ส่งมาให้ดูก่อน</p>
			<h2>ส่งลิงก์มาให้ดูก่อน ผมบอกได้ว่างานนี้ควรแก้ต่อไหม</h2>
			<p class="lede">
				บอกด้วยว่าใช้เครื่องมืออะไรสร้าง ตอนนี้ติดตรงไหน และอยากให้คนใช้ทำอะไรได้
				ผมประเมินจากของจริงก่อน ถ้าเหมาะค่อยสรุปขอบเขตและตกลงงานกันครับ
			</p>
			<div class="actions">
				<LineButton size="lg" label="ส่งลิงก์ให้ผมประเมินก่อน" />
				<a class="cta-quiet" href="/work">
					ดูผลงานที่ผ่านมา
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 48rem;
	}

	.prose {
		display: grid;
		gap: 1.125rem;
		font-size: var(--fs-body);
	}

	.prose p {
		color: var(--muted);
	}

	.prose strong {
		color: var(--ink);
		font-weight: 500;
	}

	.repair-intro {
		display: grid;
		gap: 2.25rem;
		min-width: 0;
	}

	.repair-visual {
		min-width: 0;
		align-self: center;
	}

	.repair-visual :global(.ph) {
		overflow: hidden;
		border-radius: var(--radius);
	}

	@media (min-width: 48em) {
		.repair-intro {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 3.5rem;
			align-items: center;
		}
	}

	/* The sentence the whole page turns on, lifted out of the paragraph it
	   used to end. It keeps body size and earns its weight from the ink, the
	   heading face, and the air around it, not from a fifth type step. The
	   mark above it is the same short honey dash the section labels carry,
	   which is how this system already signals "a line is starting here". */
	.pullout {
		display: grid;
		gap: 0.75rem;
		margin-block: 0.625rem;
		color: var(--ink);
		font-family: var(--font-head);
		font-weight: 500;
		line-height: 1.6;
		max-width: 30rem;
	}

	.pullout::before {
		content: "";
		width: 1.5rem;
		height: 2px;
		border-radius: 2px;
		background: var(--honey);
	}

	@media (min-width: 48em) {
		.pullout {
			margin-block: 1rem;
		}
	}

	.page-head .lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.page-head .actions {
		margin-top: 0.75rem;
	}

	.head-note {
		max-width: 36rem;
		font-size: var(--fs-body-sm);
		color: var(--muted);
	}

	/* Scope is part of the offer on this page, so the fit and non-fit cases sit
	   at equal weight. A visitor can qualify themselves without opening an FAQ,
	   and the muted card keeps a refusal from reading like an alarm. */
	.fit-grid {
		display: grid;
		gap: 1rem;
	}

	.fit-card {
		padding: 1.25rem;
		border: 1px solid var(--rule-soft);
		border-radius: var(--radius);
		background: var(--paper);
		box-shadow: var(--shadow-sm);
	}

	.fit-card.is-muted {
		background: var(--cream);
		box-shadow: none;
	}

	.fit-kicker {
		margin-bottom: 1rem;
		font-family: var(--font-head);
		font-size: var(--fs-subtitle);
		font-weight: 600;
		color: var(--ink);
	}

	.fit-list,
	.not-fit-list {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fit-list li,
	.not-fit-list li {
		position: relative;
		padding-left: 1.5rem;
		color: var(--muted);
	}

	.fit-list li::before,
	.not-fit-list li::before {
		content: "";
		position: absolute;
		top: 0.65em;
		left: 0;
		width: 0.5rem;
		height: 0.5rem;
		border: 2px solid var(--honey);
		border-radius: 50%;
	}

	.fit-list strong,
	.fit-list span {
		display: block;
	}

	.fit-list strong {
		font-family: var(--font-head);
		font-weight: 500;
		color: var(--ink);
	}

	.fit-note {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule-soft);
		font-size: var(--fs-body-sm);
		color: var(--muted);
	}

	.process-list {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.process-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		padding: 1.25rem;
		border: 1px solid var(--rule-soft);
		border-radius: var(--radius);
		background: var(--paper);
	}

	.process-n {
		font-family: var(--font-head);
		font-size: var(--fs-label);
		font-weight: 600;
		color: var(--honey-ink);
	}

	.process-item h3 {
		margin-bottom: 0.3125rem;
		font-size: var(--fs-subtitle);
		font-weight: 600;
	}

	.process-item p {
		font-size: var(--fs-body-sm);
		color: var(--muted);
	}

	@media (min-width: 48em) {
		.fit-grid,
		.process-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.fit-card,
		.process-item {
			padding: 1.5rem;
		}
	}

	/* ---- checklist ----
	   Six recurring symptoms read as one diagnostic sheet instead of six equal
	   service packages. This keeps the offer bounded without implying that every
	   incoming project needs every repair. */

	.sheet {
		max-width: 44rem;
		padding: 0.5rem 1.25rem;
		border-radius: var(--radius);
		background: var(--paper);
		border: 1px solid var(--rule-soft);
		box-shadow: var(--shadow-sm);
	}

	.checklist {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.check {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0 0.875rem;
		align-items: start;
		min-width: 0;
		padding-block: 1.125rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	.check:last-child {
		border-bottom: 0;
	}

	.check-n {
		display: grid;
		place-items: center;
		width: 1.625rem;
		height: 1.625rem;
		margin-top: 0.0625rem;
		border-radius: 6px;
		border: 1.5px solid var(--rule);
		font-family: var(--font-head);
		font-weight: 600;
		font-size: var(--fs-label);
		line-height: 1;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.check-body {
		display: grid;
		gap: 0.3125rem;
		min-width: 0;
	}

	.check-body h3 {
		font-size: var(--fs-subtitle);
		font-weight: 600;
	}

	.check-body p {
		color: var(--muted);
		font-size: var(--fs-body-sm);
		max-width: 36rem;
	}

	@media (min-width: 48em) {
		.sheet {
			padding: 0.75rem 2rem;
		}

		.check {
			gap: 0 1.25rem;
			padding-block: 1.375rem;
		}
	}
</style>
