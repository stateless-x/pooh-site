---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import { useCases, backofficeFaq } from "../data/backoffice";
import { protectThai } from "../utils/thai";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: backofficeFaq.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "หน้าแรก",
			item: new URL("/", Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "รับทำระบบหลังบ้าน",
			item: new URL("/backoffice/", Astro.site).href,
		},
	],
};
---

<Layout
	title="รับทำระบบหลังบ้านตามการทำงานจริง | Pooh"
	description="รับทำระบบหลังบ้านสำหรับธุรกิจ จัดการออเดอร์ สต๊อก ข้อมูลลูกค้า และงานภายในทีมให้อยู่ที่เดียว ออกแบบตามวิธีทำงานจริง รับปรึกษาก่อนสร้างได้ ทักไลน์ bobroach"
	schema={[faqSchema, breadcrumb]}
>
	<section class="page-head band-cream">
		<div class="shell page-head-inner">
			<p class="label">ระบบหลังบ้าน</p>
			<h1>รับทำระบบหลังบ้านตามการทำงานจริงของธุรกิจ</h1>
			<p class="lede">
				<strong
					>ระบบหลังบ้านคือที่เดียวที่ทีมใช้จัดการ<span class="nb">ออเดอร์</span> สต๊อก ข้อมูลลูกค้า และงานภายใน</strong
				> ผมออกแบบให้ตรงกับวิธีที่ธุรกิจคุณทำงานอยู่จริง ไม่ใช่บังคับให้ทีมเปลี่ยนวิธีทำงานตามระบบ
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานหลังบ้านให้ผมฟัง" />
			</div>
		</div>
	</section>

	<section class="section intro">
		<div class="shell narrow">
			<div class="prose reveal">
				<p>
					ธุรกิจส่วนใหญ่เริ่มจากไฟล์กับ<span class="nb">แชท</span>ก่อนเสมอ และวิธีนั้นก็พอไหวตอนงานยังน้อย
					พอ<span class="nb">ออเดอร์</span>เยอะขึ้น คนในทีมมากขึ้น
					สิ่งที่เคยจดไว้ในไฟล์เดียวก็เริ่มกระจายไปหลายที่ จนไม่มีใครแน่ใจว่าอันไหนคือข้อมูลล่าสุด
				</p>
				<p>
					<strong>งานของระบบหลังบ้านคือทำให้เหลือที่เดียว</strong>
					ทุกคนเปิดดูแล้วเห็นตรงกัน รู้ว่าใครทำอะไรถึงไหน
					และเจ้าของเปิดดูสรุปได้เองโดยไม่ต้องรอใครรวมไฟล์ให้
				</p>
			</div>
		</div>
	</section>

	<section class="section band-tint symptoms">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">งานที่มักจะเอามาให้ช่วย</p>
				<h2>ปัญหาหน้างานที่ระบบหลังบ้านช่วยได้</h2>
			</div>

			<ol class="cases">
				{
					useCases.map((item, i) => (
						<li class:list={["case", "reveal", `reveal-d${i % 3}`]}>
							<span class="case-n" aria-hidden="true">
								{String(i + 1).padStart(2, "0")}
							</span>
							<div class="case-body">
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section consult">
		<div class="shell">
			<div class="split">
				<div class="split-media reveal">
					<ImagePlaceholder
						alt="ภาพหน้าจอระบบหลังบ้านที่ทีมใช้ดูออเดอร์และสต๊อกร่วมกัน"
						label="ภาพหน้าจอระบบหลังบ้านตัวอย่าง"
						ratio="4 / 3"
					/>
				</div>
				<div class="split-text reveal reveal-d1">
					<p class="label">เริ่มจากปรึกษาก่อนก็ได้</p>
					<h2>เปลี่ยนเทคโนโลยีใหม่ ให้กลายเป็นวิธีทำงานที่ดีกว่า</h2>
					<p>
						ไม่ว่าจะเป็นซอฟต์แวร์ ระบบอัตโนมัติ หรือ AI
						ผมเชื่อว่าคุณค่าไม่ได้อยู่ที่เครื่องมือ แต่อยู่ที่การเลือกใช้ให้ถูกจุด
						และทำให้เกิดผลกับธุรกิจจริง
					</p>
					<p>
						หลายเจ้าที่ทักมายังไม่รู้ว่าต้องการระบบแบบไหน หรือควรทำตอนนี้เลยหรือยัง
						ผมรับปรึกษาก่อนสร้างด้วยครับ ช่วยดูว่างานตรงไหนควรทำเป็นระบบ
						ตรงไหนยังใช้วิธีเดิมไปก่อนได้ และถ้าทำ ควรเริ่มจากส่วนไหนให้เห็นผลเร็วที่สุด
					</p>
					<p>
						ถ้ามีระบบอยู่แล้วแต่ไปต่อไม่ถูก หรืออยากได้คนกลางช่วยคุยกับทีมพัฒนาให้เข้าใจตรงกัน
						ผมเป็นที่ปรึกษาให้ได้เหมือนกัน
						<a href="/fix-ai-website">ถ้าเป็นของที่สร้างด้วย AI ไว้ ดูแนวทางตรงนี้</a>
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section band-cream">
		<div class="shell narrow">
			<div class="section-head reveal">
				<p class="label">คำถามที่เจอบ่อย</p>
				<h2>เรื่องที่คนถามก่อนเริ่มทำระบบ</h2>
			</div>

			<div class="faq">
				{
					backofficeFaq.map((item, i) => (
						<details class:list={["faq-item", "reveal", `reveal-d${i % 3}`]}>
							<summary>
								<span class="faq-q">{protectThai(item.q)}</span>
								<span class="faq-sign" aria-hidden="true" />
							</summary>
							<p class="faq-a">{protectThai(item.a)}</p>
						</details>
					))
				}
			</div>

			<p class="more reveal">
				อยากรู้ว่างานแบบนี้ใช้งบประมาณเท่าไร <a href="/budget-factors"
					>ดูว่ามีอะไรบ้างที่ทำให้งบต่างกัน</a
				>
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">เริ่มจากเล่าให้ฟัง</p>
			<h2>เล่าว่าทีมทำงานยังไงอยู่ ผมช่วยดูให้ว่าควรเริ่มตรงไหน</h2>
			<p class="lede">
				ไม่ต้องเตรียมสเปกมาก่อนครับ เล่าว่าวันนี้ใครทำอะไร ติดตรงไหนบ่อยที่สุด
				แค่นั้นก็พอให้เห็นภาพแล้ว
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานหลังบ้านให้ผมฟัง" />
				<a class="cta-quiet" href="/work">
					ดูผลงานที่ผ่านมา
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 48rem;
	}

	/* The flagship page opens tight: the intro is two short beats, not a
	   reading section, so the symptom list arrives on the first scroll. */
	.intro {
		padding-block: 2.5rem 1rem;
	}

	@media (min-width: 48em) {
		.intro {
			padding-block: 4rem 1.5rem;
		}
	}

	.prose {
		display: grid;
		gap: 1.125rem;
		font-size: var(--fs-body);
	}

	.prose p {
		color: var(--muted);
		max-width: 33rem;
	}

	.prose strong,
	.page-head .lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.page-head .actions {
		margin-top: 0.75rem;
	}

	/* ---- use cases ----
	   This is the flagship page's heaviest moment, so the five symptoms read
	   as one continuous ledger the owner scans top to bottom, not as a card
	   grid the eye samples at random. One column at every width, hairline
	   separators instead of five boxes, and the number carried on a honey
	   rail so the sequence is legible without a container per item. */

	.symptoms .section-head {
		margin-bottom: 1.75rem;
	}

	.cases {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 44rem;
		border-top: 1px solid var(--rule);
	}

	.case {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0 1.125rem;
		align-items: start;
		min-width: 0;
		padding-block: 1.375rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	/* The number sits in the honey chip the rest of the system reserves for
	   icons, at label size: on a page with no icon per row it is what makes
	   the sequence readable as a sequence. */
	.case-n {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--tint-strong);
		font-family: var(--font-head);
		font-weight: 600;
		font-size: var(--fs-label);
		color: var(--honey-ink);
		font-variant-numeric: tabular-nums;
	}

	.case-body {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
	}

	.case-body h3 {
		font-size: var(--fs-subtitle);
		font-weight: 600;
	}

	.case-body p {
		color: var(--muted);
		font-size: var(--fs-body-sm);
		max-width: 34rem;
	}

	@media (min-width: 48em) {
		.case {
			grid-template-columns: auto minmax(0, 1fr);
			gap: 0 2rem;
			padding-block: 1.75rem;
		}

		.case-n {
			width: 2.5rem;
			height: 2.5rem;
			font-size: var(--fs-body-sm);
		}
	}

	/* ---- consulting split ---- */

	/* The consulting argument is the page's second act and the only section
	   with an image, so it gets the widest interval on the page: the extra
	   air is what marks it as a change of subject rather than item six. */
	.consult {
		padding-block: 4.5rem;
	}

	@media (min-width: 48em) {
		.consult {
			padding-block: 7rem;
		}
	}

	.split {
		display: grid;
		gap: 2rem;
	}

	.split-media,
	.split-text {
		min-width: 0;
	}

	.split-text {
		display: grid;
		gap: 0.75rem;
		align-content: center;
	}

	.split-text h2 {
		font-size: var(--fs-h2-lg);
	}

	.split-text p {
		color: var(--muted);
		max-width: 33rem;
	}

	@media (min-width: 48em) {
		.split {
			grid-template-columns: 1fr 1.1fr;
			gap: 3.5rem;
			align-items: center;
		}
	}
</style>
