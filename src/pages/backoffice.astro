---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import {
	useCases,
	systemTypes,
	systemLevels,
	industryGroups,
	engagementTypes,
	backofficeFaq,
} from "../data/backoffice";
import { protectThai } from "../utils/thai";
import { PERSON_FULL_NAME, ALIASES } from "../../site.config.mjs";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: backofficeFaq.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "หน้าแรก",
			item: new URL("/", Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "ระบบจัดการงานสำหรับธุรกิจ",
			item: new URL("/backoffice/", Astro.site).href,
		},
	],
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "ออกแบบและพัฒนาระบบจัดการงานสำหรับธุรกิจ",
	serviceType: "ระบบจัดการงานสำหรับธุรกิจและระบบหลังบ้าน",
	description:
		"ออกแบบระบบจัดการออเดอร์ สต๊อก ข้อมูลลูกค้า งานในทีม และรายงานตามวิธีทำงานจริงของธุรกิจ เริ่มได้ตั้งแต่งานเฉพาะจุดไปจนถึงระบบที่เชื่อมหลายส่วน",
	provider: {
		"@type": "Person",
		name: PERSON_FULL_NAME,
		alternateName: ALIASES,
		url: new URL("/about/", Astro.site).href,
	},
	areaServed: {
		"@type": "Country",
		name: "Thailand",
	},
	url: new URL("/backoffice/", Astro.site).href,
};
---

<Layout
	title="รับทำระบบจัดการงานสำหรับธุรกิจ | Pooh"
	description="รับออกแบบระบบจัดการงานสำหรับธุรกิจ รวมออเดอร์ สต๊อก ลูกค้า งานในทีม และรายงานไว้ที่เดียว เริ่มจากจุดที่เสียเวลาที่สุด ทักไลน์คุยก่อนได้"
	schema={[serviceSchema, faqSchema, breadcrumb]}
>
	<section class="page-head band-cream">
		<div class="shell page-head-inner">
			<h1>ระบบจัดการงานสำหรับธุรกิจที่ทำให้ทีมเห็นข้อมูลเดียวกัน</h1>
			<p class="lede">
				ผมช่วยรวม<span class="nb">ออเดอร์</span> สต๊อก ลูกค้า งานในทีม และรายงานที่กระจายอยู่หลายที่
				ให้คนที่เกี่ยวข้องเปิดดูและทำงานต่อกันได้ เริ่มจากจุดที่เสียเวลาหรือผิดพลาดบ่อยที่สุดก่อน
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานที่อยากจัดให้เป็นระบบ" />
				<a class="cta-quiet" href="#workflow">
					ดูว่างานแบบไหนเริ่มได้
					<Icon name="arrow" size={18} />
				</a>
			</div>
			<p class="hero-note">คุยก่อนไม่มีค่าใช้จ่าย และยังไม่ต้องเตรียมสเปก</p>
		</div>
	</section>

	<section class="section band-tint workflow" id="workflow" aria-labelledby="workflow-heading">
		<div class="shell">
			<div class="section-head reveal">
				<h2 id="workflow-heading">จากงานที่ต้องไล่ถาม สู่ข้อมูลที่ทีมเปิดดูได้เอง</h2>
				<p class="lede">
					ไม่ต้องทำทุกอย่างพร้อมกัน เลือกเรื่องที่ทำให้ทีมเสียเวลาซ้ำ ๆ ก่อน แล้ววางให้จบเป็นเรื่องเดียว
				</p>
			</div>

			<ul class="workflow-list">
				{
					useCases.map((item, i) => (
						<li class:list={["workflow-item", "reveal", `reveal-d${i % 3}`]}>
							<span class:list={["chip", i % 3 === 1 && "is-amber", i % 3 === 2 && "is-clay"]}>
								<Icon
									name={systemTypes[i].icon}
									size={28}
									loading={i === 0 ? "eager" : "lazy"}
									fetchpriority={i === 0 ? "low" : undefined}
								/>
							</span>
							<div class="workflow-problem">
								<span class="flow-label">ตอนนี้</span>
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
							<div class="workflow-answer">
								<span class="flow-label">เมื่อจัดให้เป็นระบบ</span>
								<h3>{protectThai(systemTypes[i].title)}</h3>
								<p>{protectThai(systemTypes[i].body)}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section band-cream levels" aria-labelledby="levels-heading">
		<div class="shell level-layout">
			<div class="level-intro reveal">
				<h2 id="levels-heading">ระบบควรโตตามความซับซ้อน ไม่ใช่ตามขนาดบริษัท</h2>
				<p>
					ร้านที่มีทีมเล็กอาจมีงานหลายขั้นตอน ส่วนบริษัทใหญ่บางแห่งอาจต้องแก้แค่จุดเดียว
					ผมจึงดูจากปัญหา คนที่ต้องใช้ และข้อมูลที่ต้องเชื่อมกันก่อน
				</p>
			</div>

			<ul class="level-list">
				{
					systemLevels.map((item) => (
						<li class="level-item">
							<span class="chip"><Icon name={item.icon} size={26} /></span>
							<div>
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section industries" aria-labelledby="industries-heading">
		<div class="shell">
			<div class="section-head reveal">
				<h2 id="industries-heading">ธุรกิจต่างกัน ก็มีงานที่ต้องจัดการคล้ายกัน</h2>
				<p class="lede">
					ลองดูว่าวิธีทำงานของคุณใกล้กับกลุ่มไหน แล้วเลือกเฉพาะส่วนที่ตรงกับงานจริง
				</p>
			</div>

			<ul class="industry-patterns">
				{
					industryGroups.map((item, i) => (
						<li class:list={["industry-pattern", "reveal", `reveal-d${i % 3}`]}>
							<span class:list={["chip", i % 3 === 1 && "is-amber", i % 3 === 2 && "is-clay"]}>
								<Icon name={item.icon} size={28} />
							</span>
							<div class="industry-copy">
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
								<ul class="industry-examples" aria-label={`ตัวอย่างธุรกิจในกลุ่ม${item.title}`}>
									{item.examples.map((example) => <li>{protectThai(example)}</li>)}
								</ul>
							</div>
						</li>
					))
				}
			</ul>

			<div class="industry-cta reveal">
				<p><strong>ไม่เห็นธุรกิจของคุณก็ยังคุยได้</strong> ผมดูจากวิธีทำงานจริงมากกว่าชื่อประเภทธุรกิจ</p>
				<LineButton label="เล่าวิธีทำงานของธุรกิจคุณ" />
			</div>
		</div>
	</section>

	<section class="section band-tint engagement" aria-labelledby="engagement-heading">
		<div class="shell engagement-layout">
			<div class="engagement-intro reveal">
				<h2 id="engagement-heading">เลือกจุดเริ่มให้ตรงกับสิ่งที่คุณต้องการตอนนี้</h2>
				<p>
					บางธุรกิจพร้อมสร้างแล้ว บางธุรกิจยังต้องช่วยเรียงปัญหา และบางทีมต้องการคนเข้าไปช่วยทำงานช่วงหนึ่ง
					คุยกันก่อนเพื่อเลือกแบบที่พอดีได้ครับ
				</p>
			</div>

			<div class="engagement-options">
				{
					engagementTypes.map((item, i) => (
						<article class="engagement-item">
							<span class:list={["chip", i === 1 && "is-amber", i === 2 && "is-clay"]}>
								<Icon name={item.icon} size={28} />
							</span>
							<h3>{protectThai(item.title)}</h3>
							<p>{protectThai(item.body)}</p>
						</article>
					))
				}
			</div>

			<p class="engagement-note reveal">
				ถ้ามีระบบอยู่แล้วแต่ไปต่อไม่ถูก หรืออยากได้คนกลางช่วยคุยกับทีมให้เข้าใจตรงกัน ผมช่วยดูให้ได้เช่นกัน
				ถ้าเป็นเว็บที่สร้างด้วย AI ไว้แล้ว <a href="/fix-ai-website">ดูขอบเขตงานที่ผมรับตรวจและแก้</a>
			</p>
		</div>
	</section>

	<section class="section band-cream">
		<div class="shell narrow">
			<div class="section-head reveal">
				<h2>เรื่องที่คนมักถามก่อนเริ่มจัดงานให้เป็นระบบ</h2>
			</div>

			<div class="faq">
				{
					backofficeFaq.map((item, i) => (
						<details class:list={["faq-item", "reveal", `reveal-d${i % 3}`]}>
							<summary>
								<span class="faq-q">{protectThai(item.q)}</span>
								<span class="faq-sign" aria-hidden="true" />
							</summary>
							<p class="faq-a">{protectThai(item.a)}</p>
						</details>
					))
				}
			</div>

			<p class="more reveal">
				อยากรู้ว่างานแบบนี้ใช้งบประมาณเท่าไร <a href="/budget-factors"
					>ดูว่ามีอะไรบ้างที่ทำให้งบต่างกัน</a
				>
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<h2>เล่าว่าทีมทำงานยังไงอยู่ ผมช่วยดูให้ว่าควรเริ่มตรงไหน</h2>
			<p class="lede">
				ไม่ต้องเตรียมสเปกมาก่อนครับ เล่าว่าวันนี้ใครทำอะไร ติดตรงไหนบ่อยที่สุด
				แค่นั้นก็พอให้เห็นภาพแล้ว
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานที่อยากจัดให้เป็นระบบ" />
				<a class="cta-quiet" href="/work">
					ดูผลงานที่ผ่านมา
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 48rem;
	}

	.page-head-inner {
		max-width: 52rem;
	}

	.page-head .actions {
		margin-top: 0.875rem;
	}

	.hero-note {
		margin-top: 0.875rem;
		color: var(--muted);
		font-size: var(--fs-body-sm);
	}

	.workflow .section-head,
	.industries .section-head {
		max-width: 44rem;
	}

	.workflow-list,
	.level-list,
	.industry-patterns,
	.industry-examples {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.workflow-list {
		border-top: 1px solid var(--rule);
	}

	.workflow-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.875rem 1rem;
		align-items: start;
		padding-block: 1.375rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	.workflow-problem,
	.workflow-answer,
	.industry-copy,
	.level-item > div {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
	}

	.workflow-answer {
		grid-column: 2;
		padding-top: 0.875rem;
		border-top: 1px solid var(--rule-soft);
	}

	.flow-label {
		font-family: var(--font-head);
		font-size: var(--fs-label);
		font-weight: 500;
		color: var(--honey-ink);
	}

	.workflow-item h3,
	.level-item h3,
	.industry-pattern h3,
	.engagement-item h3 {
		font-size: var(--fs-subtitle);
	}

	.workflow-item p,
	.level-item p,
	.industry-pattern p,
	.engagement-item p,
	.level-intro > p:last-child,
	.engagement-intro > p:last-child {
		color: var(--muted);
		font-size: var(--fs-body-sm);
	}

	.workflow-item p {
		max-width: 31rem;
	}

	@media (min-width: 48em) {
		.workflow-item {
			grid-template-columns: 4rem minmax(0, 0.9fr) minmax(0, 1fr);
			gap: 1.75rem;
			padding-block: 1.75rem;
		}

		.workflow-answer {
			grid-column: auto;
			padding: 0 0 0 1.75rem;
			border-top: 0;
			border-left: 1px solid var(--rule);
		}
	}

	.level-layout,
	.engagement-layout {
		display: grid;
		gap: 2.25rem;
		min-width: 0;
	}

	.level-intro,
	.engagement-intro {
		display: grid;
		gap: 0.875rem;
		align-content: start;
		min-width: 0;
	}

	.level-intro h2,
	.engagement-intro h2 {
		font-size: var(--fs-h2-lg);
		text-wrap: balance;
	}

	.level-intro > p:last-child,
	.engagement-intro > p:last-child {
		max-width: 33rem;
	}

	.level-list {
		border-top: 1px solid var(--rule);
	}

	.level-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	@media (min-width: 56em) {
		.level-layout,
		.engagement-layout {
			grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
			gap: 4rem;
			align-items: start;
		}
	}

	.industry-patterns {
		display: grid;
		gap: 1rem;
	}

	.industry-pattern {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1.125rem;
		align-items: start;
		padding: 1.25rem;
		border: 1px solid var(--rule-soft);
		border-radius: var(--radius);
		background: var(--paper);
		box-shadow: var(--shadow-sm);
	}

	.industry-copy {
		display: grid;
		gap: 0.625rem;
		min-width: 0;
	}

	.industry-copy h3 {
		font-size: 1.125rem;
		line-height: 1.45;
	}

	.industry-copy > p {
		max-width: 33rem;
		color: var(--muted);
		font-size: var(--fs-body-sm);
	}

	.industry-examples {
		display: grid;
		gap: 0.375rem;
		margin-top: 0.125rem;
	}

	.industry-examples li {
		position: relative;
		width: 100%;
		padding: 0.5rem 0.625rem 0.5rem 1.625rem;
		border-radius: 0.625rem;
		background: var(--tint);
		color: var(--muted);
		font-size: var(--fs-label);
		line-height: 1.5;
	}

	.industry-examples li::before {
		position: absolute;
		left: 0.75rem;
		top: 0.95rem;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--honey);
		content: "";
	}

	.industry-cta {
		display: grid;
		gap: 1rem;
		align-items: center;
		margin-top: 1rem;
		padding: 1.25rem;
		border: 1px solid var(--rule-soft);
		border-radius: var(--radius);
		background: var(--tint);
	}

	.industry-cta p {
		max-width: 38rem;
		color: var(--muted);
	}

	.industry-cta strong {
		color: var(--ink);
		font-weight: 600;
	}

	@media (min-width: 48em) {
		.industry-patterns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.industry-pattern {
			padding: 1.5rem;
		}

		.industry-cta {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2rem;
		}
	}

	.engagement-options {
		display: grid;
		border-top: 1px solid var(--rule);
	}

	.engagement-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.375rem 1rem;
		align-items: start;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	.engagement-item .chip {
		grid-row: 1 / span 2;
	}

	.engagement-item p {
		max-width: 31rem;
	}

	.engagement-note {
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: var(--fs-body-sm);
		max-width: 43rem;
	}

	@media (min-width: 56em) {
		.engagement-note {
			grid-column: 2;
		}
	}
</style>
