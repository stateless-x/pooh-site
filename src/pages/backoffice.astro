---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import {
	useCases,
	systemTypes,
	systemLevels,
	industries,
	engagementTypes,
	backofficeFaq,
} from "../data/backoffice";
import { protectThai } from "../utils/thai";
import { PERSON_FULL_NAME, ALIASES } from "../../site.config.mjs";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: backofficeFaq.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "หน้าแรก",
			item: new URL("/", Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "ระบบจัดการงานสำหรับธุรกิจ",
			item: new URL("/backoffice/", Astro.site).href,
		},
	],
};

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: "ออกแบบและพัฒนาระบบจัดการงานสำหรับธุรกิจ",
	serviceType: "ระบบจัดการงานสำหรับธุรกิจและระบบหลังบ้าน",
	description:
		"ออกแบบระบบจัดการออเดอร์ สต๊อก ข้อมูลลูกค้า งานในทีม และรายงานตามวิธีทำงานจริงของธุรกิจ เริ่มได้ตั้งแต่งานเฉพาะจุดไปจนถึงระบบที่เชื่อมหลายส่วน",
	provider: {
		"@type": "Person",
		name: PERSON_FULL_NAME,
		alternateName: ALIASES,
		url: new URL("/about/", Astro.site).href,
	},
	areaServed: {
		"@type": "Country",
		name: "Thailand",
	},
	url: new URL("/backoffice/", Astro.site).href,
};
---

<Layout
	title="รับทำระบบจัดการงานสำหรับธุรกิจ | Pooh"
	description="รับออกแบบและพัฒนาระบบจัดการงานสำหรับธุรกิจและระบบหลังบ้าน ตั้งแต่ออเดอร์ สต๊อก ลูกค้า งานในทีม ไปจนถึงระบบเฉพาะสำหรับโรงงาน ร้านอาหาร โรงแรม และธุรกิจบริการ ทักไลน์ bobroach"
	schema={[serviceSchema, faqSchema, breadcrumb]}
>
	<section class="page-head band-cream">
		<div class="shell page-head-inner">
			<p class="label">ระบบจัดการงานสำหรับธุรกิจ</p>
			<h1>รับออกแบบและพัฒนาระบบตามวิธีทำงานจริงของธุรกิจ</h1>
			<p class="lede">
				<strong
					>รวม<span class="nb">ออเดอร์</span> สต๊อก ลูกค้า งานในทีม และรายงานให้คนที่เกี่ยวข้องเห็นข้อมูลชุดเดียวกัน</strong
				> เริ่มจากจุดที่เสียเวลาหรือผิดพลาดบ่อยที่สุดก่อน แล้วค่อยต่อยอดเมื่อทีมพร้อม
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานที่อยากจัดให้เป็นระบบ" />
			</div>
		</div>
	</section>

	<section class="section intro">
		<div class="shell narrow">
			<div class="prose reveal">
				<p>
					ธุรกิจส่วนใหญ่เริ่มจากไฟล์กับ<span class="nb">แชท</span>ก่อนเสมอ และวิธีนั้นก็พอไหวตอนงานยังน้อย
					พอ<span class="nb">ออเดอร์</span>เยอะขึ้น คนในทีมมากขึ้น
					สิ่งที่เคยจดไว้ในไฟล์เดียวก็เริ่มกระจายไปหลายที่ จนไม่มีใครแน่ใจว่าอันไหนคือข้อมูลล่าสุด
				</p>
				<p>
					<strong>ระบบที่ดีไม่ได้ทำให้งานเดิมซับซ้อนขึ้น แต่ช่วยให้ทุกคนเห็นเรื่องสำคัญตรงกัน</strong>
					ทุกคนเปิดดูแล้วเห็นตรงกัน รู้ว่าใครทำอะไรถึงไหน
					และเจ้าของเปิดดูสรุปได้เองโดยไม่ต้องรอใครรวมไฟล์ให้
				</p>
			</div>
		</div>
	</section>

	<section class="section band-tint symptoms">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">งานที่มักจะเอามาให้ช่วย</p>
				<h2>ถ้างานเริ่มมีอาการแบบนี้ ถึงเวลาจัดให้เป็นระบบ</h2>
			</div>

			<ol class="cases">
				{
					useCases.map((item, i) => (
						<li class:list={["case", "reveal", `reveal-d${i % 3}`]}>
							<span class="case-n" aria-hidden="true">
								{String(i + 1).padStart(2, "0")}
							</span>
							<div class="case-body">
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section systems" aria-labelledby="systems-heading">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">สิ่งที่นำมารวมไว้ได้</p>
				<h2 id="systems-heading">งานแบบไหนที่ทำเป็นระบบได้บ้าง</h2>
				<p class="lede">
					ไม่จำเป็นต้องทำทุกอย่างพร้อมกันครับ เลือกเฉพาะส่วนที่ทำให้ทีมเสียเวลาหรือเกิดข้อผิดพลาดบ่อยก่อน
				</p>
			</div>

			<ul class="system-list">
				{
					systemTypes.map((item, i) => (
						<li class="system-item">
							<span class:list={["chip", i % 3 === 1 && "is-amber", i % 3 === 2 && "is-clay"]}>
								<Icon name={item.icon} size={28} />
							</span>
							<div>
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ul>

			<div class="system-visual reveal">
				<ImagePlaceholder
					alt="ภาพหน้าจอตัวอย่างระบบจัดการงานที่แสดงออเดอร์ สต๊อก สถานะงาน และรายงานในมุมมองเดียว"
					label="ภาพหน้าจอระบบตัวอย่าง ใช้ข้อมูลจำลอง ไม่ใช้ข้อมูลลูกค้าจริง"
					ratio="16 / 10"
					sizes="(min-width: 68rem) 54rem, (min-width: 48rem) calc(100vw - 5rem), calc(100vw - 2.75rem)"
				/>
			</div>
		</div>
	</section>

	<section class="section band-cream levels" aria-labelledby="levels-heading">
		<div class="shell level-layout">
			<div class="level-intro reveal">
				<p class="label">เริ่มให้พอดีกับงาน</p>
				<h2 id="levels-heading">ระบบควรโตตามความซับซ้อน ไม่ใช่ตามขนาดบริษัท</h2>
				<p>
					ร้านที่มีทีมเล็กอาจมีงานหลายขั้นตอน ส่วนบริษัทใหญ่บางแห่งอาจต้องแก้แค่จุดเดียว
					ผมจึงดูจากปัญหา คนที่ต้องใช้ และข้อมูลที่ต้องเชื่อมกันก่อน
				</p>
			</div>

			<ol class="level-list">
				{
					systemLevels.map((item, i) => (
						<li class="level-item">
							<span class="level-count" aria-hidden="true">{i + 1}</span>
							<span class="chip"><Icon name={item.icon} size={26} /></span>
							<div>
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section industries" aria-labelledby="industries-heading">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">ดูตัวอย่างจากธุรกิจที่ใกล้เคียง</p>
				<h2 id="industries-heading">ระบบเดียวกันไม่ควรใช้เหมือนกันทุกอุตสาหกรรม</h2>
				<p class="lede">
					ตัวอย่างด้านล่างคือปัญหาที่นำมาออกแบบเป็นระบบได้ ไม่ใช่แบบสำเร็จรูป
					งานจริงจะเลือกเฉพาะสิ่งที่ตรงกับวิธีทำงานของคุณ
				</p>
			</div>

			<ul class="industry-list">
				{
					industries.map((item, i) => (
						<li class="industry-item">
							<span class:list={["chip", i % 3 === 1 && "is-amber", i % 3 === 2 && "is-clay"]}>
								<Icon name={item.icon} size={28} />
							</span>
							<div>
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section band-tint engagement" aria-labelledby="engagement-heading">
		<div class="shell engagement-layout">
			<div class="engagement-intro reveal">
				<p class="label">วิธีร่วมงาน</p>
				<h2 id="engagement-heading">เลือกจุดเริ่มให้ตรงกับสิ่งที่คุณต้องการตอนนี้</h2>
				<p>
					บางธุรกิจพร้อมสร้างแล้ว บางธุรกิจยังต้องช่วยเรียงปัญหา และบางทีมต้องการคนเข้าไปช่วยทำงานช่วงหนึ่ง
					คุยกันก่อนเพื่อเลือกแบบที่พอดีได้ครับ
				</p>
			</div>

			<div class="engagement-options">
				{
					engagementTypes.map((item, i) => (
						<article class="engagement-item">
							<span class:list={["chip", i === 1 && "is-amber", i === 2 && "is-clay"]}>
								<Icon name={item.icon} size={28} />
							</span>
							<h3>{protectThai(item.title)}</h3>
							<p>{protectThai(item.body)}</p>
						</article>
					))
				}
			</div>

			<p class="engagement-note reveal">
				ถ้ามีระบบอยู่แล้วแต่ไปต่อไม่ถูก หรืออยากได้คนกลางช่วยคุยกับทีมให้เข้าใจตรงกัน ผมช่วยดูให้ได้เช่นกัน
				ถ้าเป็นเว็บที่สร้างด้วย AI ไว้แล้ว <a href="/fix-ai-website">ดูขอบเขตงานที่ผมรับตรวจและแก้</a>
			</p>
		</div>
	</section>

	<section class="section band-cream">
		<div class="shell narrow">
			<div class="section-head reveal">
				<p class="label">คำถามที่เจอบ่อย</p>
				<h2>เรื่องที่คนมักถามก่อนเริ่มจัดงานให้เป็นระบบ</h2>
			</div>

			<div class="faq">
				{
					backofficeFaq.map((item, i) => (
						<details class:list={["faq-item", "reveal", `reveal-d${i % 3}`]}>
							<summary>
								<span class="faq-q">{protectThai(item.q)}</span>
								<span class="faq-sign" aria-hidden="true" />
							</summary>
							<p class="faq-a">{protectThai(item.a)}</p>
						</details>
					))
				}
			</div>

			<p class="more reveal">
				อยากรู้ว่างานแบบนี้ใช้งบประมาณเท่าไร <a href="/budget-factors"
					>ดูว่ามีอะไรบ้างที่ทำให้งบต่างกัน</a
				>
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">เริ่มจากเล่าให้ฟัง</p>
			<h2>เล่าว่าทีมทำงานยังไงอยู่ ผมช่วยดูให้ว่าควรเริ่มตรงไหน</h2>
			<p class="lede">
				ไม่ต้องเตรียมสเปกมาก่อนครับ เล่าว่าวันนี้ใครทำอะไร ติดตรงไหนบ่อยที่สุด
				แค่นั้นก็พอให้เห็นภาพแล้ว
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานที่อยากจัดให้เป็นระบบ" />
				<a class="cta-quiet" href="/work">
					ดูผลงานที่ผ่านมา
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 48rem;
	}

	/* The flagship page opens tight: the intro is two short beats, not a
	   reading section, so the symptom list arrives on the first scroll. */
	.intro {
		padding-block: 2.5rem 1rem;
	}

	@media (min-width: 48em) {
		.intro {
			padding-block: 4rem 1.5rem;
		}
	}

	.prose {
		display: grid;
		gap: 1.125rem;
		font-size: var(--fs-body);
	}

	.prose p {
		color: var(--muted);
		max-width: 33rem;
	}

	.prose strong,
	.page-head .lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	.page-head .actions {
		margin-top: 0.75rem;
	}

	/* ---- use cases ----
	   This is the flagship page's heaviest moment, so the five symptoms read
	   as one continuous ledger the owner scans top to bottom, not as a card
	   grid the eye samples at random. One column at every width, hairline
	   separators instead of five boxes, and the number carried on a honey
	   rail so the sequence is legible without a container per item. */

	.symptoms .section-head {
		margin-bottom: 1.75rem;
	}

	.cases {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 44rem;
		border-top: 1px solid var(--rule);
	}

	.case {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0 1.125rem;
		align-items: start;
		min-width: 0;
		padding-block: 1.375rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	/* The number sits in the honey chip the rest of the system reserves for
	   icons, at label size: on a page with no icon per row it is what makes
	   the sequence readable as a sequence. */
	.case-n {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--tint-strong);
		font-family: var(--font-head);
		font-weight: 600;
		font-size: var(--fs-label);
		color: var(--honey-ink);
		font-variant-numeric: tabular-nums;
	}

	.case-body {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
	}

	.case-body h3 {
		font-size: var(--fs-subtitle);
		font-weight: 600;
	}

	.case-body p {
		color: var(--muted);
		font-size: var(--fs-body-sm);
		max-width: 34rem;
	}

	@media (min-width: 48em) {
		.case {
			grid-template-columns: auto minmax(0, 1fr);
			gap: 0 2rem;
			padding-block: 1.75rem;
		}

		.case-n {
			width: 2.5rem;
			height: 2.5rem;
			font-size: var(--fs-body-sm);
		}
	}

	/* ---- system types ---- */

	.systems .section-head,
	.industries .section-head {
		max-width: 43rem;
	}

	.system-list,
	.industry-list,
	.level-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.system-list,
	.industry-list {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--rule);
	}

	.system-item,
	.industry-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		min-width: 0;
		padding-block: 1.375rem;
		border-bottom: 1px solid var(--rule-soft);
	}

	.system-item > div,
	.industry-item > div {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
	}

	.system-item h3,
	.industry-item h3,
	.level-item h3,
	.engagement-item h3 {
		font-size: var(--fs-subtitle);
	}

	.system-item p,
	.industry-item p,
	.level-item p,
	.engagement-item p,
	.level-intro > p:last-child,
	.engagement-intro > p:last-child {
		color: var(--muted);
		font-size: var(--fs-body-sm);
	}

	.system-item p,
	.industry-item p {
		max-width: 31rem;
	}

	.system-visual {
		max-width: 54rem;
		margin-top: 2.5rem;
	}

	.system-visual :global(.ph) {
		overflow: hidden;
		border-radius: var(--radius);
	}

	@media (min-width: 48em) {
		.system-list,
		.industry-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 2.5rem;
		}

		.system-item,
		.industry-item {
			padding-block: 1.625rem;
		}

		.system-item:last-child {
			grid-column: 1 / -1;
		}

		.system-item:last-child p {
			max-width: 35rem;
		}

		.system-visual {
			margin-top: 3.25rem;
		}
	}

	/* ---- right-sized system levels ---- */

	.level-layout,
	.engagement-layout {
		display: grid;
		gap: 2.25rem;
		min-width: 0;
	}

	.level-intro,
	.engagement-intro {
		display: grid;
		gap: 0.875rem;
		align-content: start;
		min-width: 0;
	}

	.level-intro h2,
	.engagement-intro h2 {
		font-size: var(--fs-h2-lg);
		text-wrap: balance;
	}

	.level-intro > p:last-child,
	.engagement-intro > p:last-child {
		max-width: 33rem;
	}

	.level-list {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--rule);
	}

	.level-item {
		display: grid;
		grid-template-columns: 1.25rem auto minmax(0, 1fr);
		gap: 0.875rem;
		align-items: start;
		min-width: 0;
		padding-block: 1.375rem;
		border-bottom: 1px solid var(--rule);
	}

	.level-count {
		padding-top: 0.875rem;
		font-family: var(--font-head);
		font-size: var(--fs-label);
		font-weight: 600;
		color: var(--honey-ink);
		font-variant-numeric: tabular-nums;
	}

	.level-item > div {
		display: grid;
		gap: 0.375rem;
		padding-top: 0.25rem;
		min-width: 0;
	}

	@media (min-width: 48em) {
		.level-layout {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			gap: 4.5rem;
			align-items: start;
		}
