---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import { factors, budgetFaq } from "../data/budget";
import { protectThai } from "../utils/thai";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: budgetFaq.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "หน้าแรก",
			item: new URL("/", Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "งบประมาณขึ้นกับอะไรบ้าง",
			item: new URL("/budget-factors/", Astro.site).href,
		},
	],
};
---

<Layout
	title="ทำเว็บไซต์หรือระบบ ใช้งบเท่าไหร่ | Pooh"
	description="ทำเว็บไซต์หรือระบบใช้งบเท่าไหร่ ตอบตรง ๆ ว่าขึ้นกับขอบเขตงาน งานเล็กเริ่มหลักพัน ระบบใหญ่ขยับหลักหมื่นหลักแสน พร้อมหกปัจจัยที่ทำให้งบต่างกัน ประเมินฟรี"
	schema={[faqSchema, breadcrumb]}
>
	<section class="page-head band-cream">
		<div class="shell page-head-inner">
			<p class="label">งบประมาณ</p>
			<h1>ทำเว็บไซต์หรือระบบ ใช้งบเท่าไหร่ ขึ้นกับอะไรบ้าง</h1>
			<p class="lede">
				<strong>ตอบตรง ๆ ว่าช่วงราคาในตลาดกว้างมาก</strong>
				เพราะคำว่าเว็บหรือระบบครอบคลุมงานตั้งแต่หน้าเดียวจบไปจนถึงระบบที่ทั้งบริษัทใช้
				หน้านี้อธิบายว่าอะไรบ้างที่ทำให้ตัวเลขต่างกัน เพื่อให้คุยกันได้ตรงเรื่องขึ้น
				งานเล็ก ๆ เริ่มได้ตั้งแต่หลักพัน ส่วนระบบที่ใหญ่ขึ้นก็ขยับไปหลักหมื่นหลักแสนตามขนาดงาน
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">หกเรื่องที่มีผลกับงบ</p>
				<h2>อะไรบ้างที่ทำให้งานสองชิ้นราคาไม่เท่ากัน</h2>
			</div>

			<ol class="factors">
				{
					factors.map((item, i) => (
						<li class:list={["factor", "reveal", `reveal-d${i % 3}`]}>
							<span class="factor-n" aria-hidden="true">
								{String(i + 1).padStart(2, "0")}
							</span>
							<div class="factor-body">
								<h3>{protectThai(item.title)}</h3>
								<p>{protectThai(item.body)}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="shell narrow">
			<div class="section-head reveal">
				<p class="label">คำถามที่เจอบ่อย</p>
				<h2>เรื่องงบที่คนถามมาบ่อยที่สุด</h2>
			</div>

			<div class="faq">
				{
					budgetFaq.map((item, i) => (
						<details class:list={["faq-item", "reveal", `reveal-d${i % 3}`]}>
							<summary>
								<span class="faq-q">{protectThai(item.q)}</span>
								<span class="faq-sign" aria-hidden="true" />
							</summary>
							<p class="faq-a">{protectThai(item.a)}</p>
						</details>
					))
				}
			</div>

			<p class="more reveal">
				อยากเห็นว่างานระบบหลังบ้านทำอะไรได้บ้าง <a href="/backoffice"
					>ดูหน้าระบบหลังบ้าน</a
				> หรือ<a href="/work">ดูผลงานที่ผ่านมา</a>
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">ประเมินให้ก่อนได้</p>
			<h2>เล่ามาก่อนว่าอยากได้อะไร ผมประเมินให้ฟรี</h2>
			<p class="lede">
				ราคาของแต่ละงานขึ้นกับขอบเขตจริง ไม่ต้องเดาเอง เล่ามาว่าธุรกิจทำอะไรและอยากได้อะไร
				ผมจะบอกกลับว่างานประมาณไหนและมีทางไหนที่ประหยัดกว่าบ้าง ประเมินเบื้องต้นไม่มี<span class="nb">ค่าใช้จ่าย</span>และไม่มีข้อผูกมัด
			</p>
			<div class="actions">
				<LineButton size="lg" label="เล่างานให้ผมประเมินให้" />
				<a class="cta-quiet" href="/contact">
					ดูวิธีติดต่อ
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 48rem;
	}

	.page-head .lede strong {
		color: var(--ink);
		font-weight: 500;
	}

	/* ---- factors ----
	   This page argues that no single number exists because six things move
	   it, so the six read as one continuous scale rather than six equal
	   cards: a single column with an unbroken rule running the full height
	   and a honey tick at each stop. The reader sees one measurement with
	   six positions on it, which is the argument the copy makes.
	   The ticks stay the same size on purpose: the copy names ขอบเขตงาน as
	   the largest driver and it comes first, so a mark that grew downward
	   would state the opposite of what the page says. */

	.factors {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 42rem;
	}

	.factor {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0 1.25rem;
		align-items: start;
		min-width: 0;
		padding: 1.25rem 0 1.5rem;
	}

	/* One continuous line down the whole scale rather than a border per
	   item: the six are stages of one measurement, not six separate things. */
	/* One unbroken rule behind the whole scale, running through every stop
	   rather than restarting per item. */
	.factor::before {
		content: "";
		position: absolute;
		left: 0.53125rem;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--rule);
	}

	.factor:first-child::before {
		top: 1.5rem;
	}

	.factor:last-child::before {
		bottom: auto;
		height: 1.5rem;
	}

	/* Each stop is a honey tick cutting across the rule with its number
	   beside it, so the six read as positions on one measurement. */
	.factor-n {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.375rem;
		width: 1.0625rem;
		padding-block: 0.9375rem;
		font-family: var(--font-head);
		font-weight: 600;
		font-size: var(--fs-label);
		line-height: 1;
		color: var(--honey-ink);
		font-variant-numeric: tabular-nums;
		background: var(--cream);
	}

	.factor-n::before {
		content: "";
		width: 0.6875rem;
		height: 3px;
		border-radius: 2px;
		background: var(--honey);
	}

	.factor-body {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
	}

	.factor-body h3 {
		font-size: var(--fs-subtitle);
		font-weight: 600;
	}

	.factor-body p {
		color: var(--muted);
		font-size: var(--fs-body-sm);
		max-width: 34rem;
	}

	@media (min-width: 48em) {
		.factor {
			gap: 0 1.75rem;
			padding: 1.5rem 0 1.75rem;
		}
	}
</style>
