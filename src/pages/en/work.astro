---
import Layout from "../../layouts/Layout.astro";
import BrowserFrame from "../../components/BrowserFrame.astro";
import Icon from "../../components/Icon.astro";
import MailButton from "../../components/MailButton.astro";
import { works } from "../../data/works";
import { enBreadcrumb } from "../../utils/schema-en";
import { EMAIL } from "../../../site.config.mjs";

// pawjai.co leads as the featured card for the same reason it does on the
// Thai page: it is the one thing here he owns end to end, which is the
// strongest answer to "will you still be around after launch". The rest run
// in the English teaser order, so the cross-border and multilingual work
// comes first for a reader who is not in Thailand.
const featuredWork = works.find((w) => w.name === "pawjai.co")!;
const otherWork = works
	.filter((w) => w !== featuredWork)
	.sort((a, b) => (a.teaserEn ?? Infinity) - (b.teaserEn ?? Infinity));

const breadcrumb = enBreadcrumb(Astro.site, "Work", "/en/work/");
---

<Layout
	lang="en"
	title="Work: Websites and Systems That Are Live Now | Pooh"
	description="Real work from a freelance developer in Bangkok, Thailand: a multilingual site serving cross-border visitors, factory websites, a trilingual property platform, and a pet product he runs himself."
	schema={breadcrumb}
>
	<section class="page-head band-cream">
		<div class="shell page-head-inner">
			<p class="label">Work</p>
			<h1>Some things I have built that are running right now</h1>
			<p class="lede">
				These are live sites and systems with real users on them, not mockups,
				including one product I own and run myself.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<article class="work-item featured reveal">
				<div class="featured-media">
					<BrowserFrame
						domain={featuredWork.name}
						alt={featuredWork.en.alt}
						label={featuredWork.en.label}
						src={featuredWork.image}
						ratio="16 / 9"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<div class="featured-text">
					<span class="tag is-amber">A product I own and run</span>
					<h2>{featuredWork.name}</h2>
					<p>{featuredWork.en.long}</p>
					<a
						class="work-link"
						href={featuredWork.url}
						target="_blank"
						rel="noopener"
					>
						Open the site
						<Icon name="external" size={16} />
					</a>
				</div>
			</article>

			<div class="work-list full">
				{
					otherWork.map((w, i) => (
						<article
							class:list={["work-item", "wide", "reveal", `reveal-d${i % 2}`]}
						>
							<div class="wide-media">
								<BrowserFrame
									domain={w.name}
									alt={w.en.alt}
									label={w.en.label}
									src={w.image}
									ratio="16 / 9"
								/>
							</div>
							<div class="wide-text">
								<span class:list={["tag", `is-${w.tint}`]}>{w.en.kind}</span>
								<h2>{w.name}</h2>
								<p>{w.en.long}</p>
								{w.url ? (
									<a class="work-link" href={w.url} target="_blank" rel="noopener">
										Open the site
										<Icon name="external" size={16} />
									</a>
								) : (
									<p class="work-status">{w.en.status}</p>
								)}
							</div>
						</article>
					))
				}
			</div>

			<p class="more reveal">
				There is more I can show you that is not listed here. Tell me what you
				are building and <a href="/en/contact/">I will find the nearest thing I
				have worked on</a>. If you have already started something with AI, <a
					href="/en/fix-ai-website/">here is what I take on</a
				>.
			</p>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">Get in touch</p>
			<h2>Want to see something closer to your own project?</h2>
			<p class="lede">
				Tell me what your business does and I will pick out the work that is
				nearest to it, and tell you honestly what was hard about it.
			</p>
			<div class="actions">
				<MailButton label={`Email ${EMAIL}`} tone="on-dark" />
				<a class="cta-quiet" href="/en/contact/">
					Other ways to reach me
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.featured {
		display: grid;
		gap: 1.25rem;
		padding: 1.25rem;
		margin-bottom: 2.5rem;
		border-color: var(--honey-edge);
		box-shadow: var(--shadow-md);
	}

	.featured-media {
		min-width: 0;
	}

	.featured-text {
		display: grid;
		gap: 0.625rem;
		align-content: center;
		justify-items: start;
		min-width: 0;
	}

	.featured-text h2 {
		font-size: var(--fs-h2-lg);
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.featured-text p {
		color: var(--muted);
		max-width: 36rem;
	}

	.featured-text .work-link {
		margin-top: 0.375rem;
	}

	@media (min-width: 48em) {
		.featured {
			grid-template-columns: 1.35fr 1fr;
			gap: 2.5rem;
			padding: 1.75rem;
			margin-bottom: 3.5rem;
		}
	}

	.full {
		gap: 2rem;
	}

	.wide {
		gap: 1.25rem;
		padding: 1.25rem;
	}

	.wide-text {
		display: grid;
		gap: 0.625rem;
		align-content: start;
	}

	.wide-text h2 {
		font-size: var(--fs-h2);
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.wide-text p {
		color: var(--muted);
		max-width: 38rem;
	}

	/* Stands in for the link on work that is built but not published. Muted
	   and label-sized so it reads as a status, never as a dead control. */
	.work-status {
		margin-top: 0.375rem;
		color: var(--muted);
		font-size: var(--fs-body-sm);
	}

	.wide-text .work-link {
		margin-top: 0.375rem;
	}

	@media (min-width: 48em) {
		.wide {
			grid-template-columns: 1.15fr 1fr;
			gap: 2.25rem;
			align-items: center;
			padding: 1.5rem;
		}

		.full {
			gap: 2.5rem;
		}
	}

	.more {
		margin-top: 3rem;
	}
</style>
