---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import poohAtWork from "../assets/images/illustrations/pooh-at-work.webp";
import { works } from "../data/works";
import { systemTypes } from "../data/backoffice";
import { protectThai } from "../utils/thai";
import {
	PERSON_FULL_NAME,
	ALIASES,
	PERSON_TITLE,
	GITHUB_URL,
	LINE_URL,
	LINE_ID,
	EMAIL,
} from "../../site.config.mjs";

// The home teaser shows three, in the order set by their teaser rank; /work
// carries the full set.
const featured = works
	.filter((w) => w.teaser)
	.sort((a, b) => a.teaser! - b.teaser!);

const offers = [
	{
		// The lowest-risk rung on the ladder: ปรึกษา -> สร้าง -> ดูแลต่อ.
		icon: "help",
		tint: "is-amber",
		title: "ปรึกษาด้านเทคโนโลยีและระบบ",
		body: "ยังไม่ต้องจ้างทำก็คุยได้ ช่วยดูว่าควรเริ่มตรงไหนและอะไรยังไม่ต้องทำตอนนี้",
		href: "/contact/",
		linkLabel: "ดูวิธีเริ่มคุย",
	},
	{
		icon: "flow",
		tint: "is-clay",
		title: "ระบบจัดการงานสำหรับธุรกิจ",
		body: "รวมออเดอร์ สต๊อก ลูกค้า และงานในทีม ให้ทุกคนเห็นข้อมูลชุดเดียวกัน",
		href: "/backoffice/",
		linkLabel: "ดูรายละเอียดระบบธุรกิจ",
	},
	{
		icon: "storefront",
		tint: "",
		title: "เว็บไซต์ธุรกิจ",
		body: "ลูกค้าเข้าใจว่าคุณทำอะไรภายในไม่กี่วินาที และติดต่อกลับได้ง่าย",
		href: "/work/",
		linkLabel: "ดูตัวอย่างเว็บไซต์",
	},
	{
		icon: "care",
		tint: "",
		title: "ดูแลและต่อยอด",
		body: "ส่งงานแล้วไม่ทิ้งงาน ปรับแก้และต่อยอดได้ตามที่ธุรกิจโตขึ้น",
		href: "/contact/",
		linkLabel: "คุยเรื่องดูแลและต่อยอด",
	},
] as const;

const steps = [
	{
		n: "01",
		icon: "listen",
		title: "ฟังปัญหาก่อน",
		body: "ถามก่อนว่าติดขัดตรงไหน ยังไม่รีบเสนอวิธีทำ",
	},
	{
		n: "02",
		icon: "scope",
		title: "สรุปขอบเขตให้ชัด",
		body: "เขียนเป็นข้อ ๆ ว่าทำอะไรบ้างและใช้เวลาเท่าไร ตกลงกันก่อนลงมือ",
	},
	{
		n: "03",
		icon: "updates",
		title: "อัปเดตเป็นระยะ",
		body: "เห็นงานจริงเป็นช่วง ๆ ไม่ต้องรอจนจบถึงจะได้ดู",
	},
	{
		n: "04",
		icon: "deliver",
		title: "ส่งมอบพร้อมใช้จริง",
		body: "ส่งงานที่เปิดใช้ได้ทันที พร้อมวิธีดูแลต่อ",
	},
] as const;

// Only facts already stated on the page. No years, counts, or ratings.
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: PERSON_FULL_NAME,
	// Every name a person or an assistant might use for him, so a retrieval
	// bot matching on any one of them resolves to the same entity.
	alternateName: ALIASES,
	// Matches the visible hero chip exactly, so chip, schema, and spec agree.
	jobTitle: PERSON_TITLE,
	// Mirrors the visible canonical entity paragraph in the About strip.
	description:
		"ภูรินท์ บุรีวงศ์ (คุณพูห์ หรือ Pooh) คือนักพัฒนาเทคโนโลยีเพื่อธุรกิจ รับออกแบบและพัฒนาระบบจัดการงาน เว็บไซต์ธุรกิจ และรับปรึกษาด้านเทคโนโลยี มีประสบการณ์พัฒนาซอฟต์แวร์มากกว่า 7 ปี จบวิศวกรรมคอมพิวเตอร์จาก Mahidol University International College ปัจจุบันเป็นผู้ก่อตั้งและผู้พัฒนาหลักของ pawjai.co ควบคู่กับงานอิสระ อยู่กรุงเทพและทำงานร่วมกับลูกค้าได้ทั่วประเทศ ใช้ AI ช่วยให้งานเร็วขึ้นบนพื้นฐานวิศวกรรมที่ดูแลต่อได้ ติดต่อทางไลน์หรืออีเมล askpurin@pm.me",
	email: EMAIL,
	url: new URL("/", Astro.site).href,
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "Mahidol University International College",
	},
	address: {
		"@type": "PostalAddress",
		addressLocality: "Bangkok",
		addressCountry: "TH",
	},
	// Founder relationship to the SaaS he runs, stated as a real entity so the
	// project and the person are linkable rather than only named in prose.
	worksFor: {
		"@type": "Organization",
		name: "pawjai.co",
		url: "https://pawjai.co",
	},
	// Two registers on purpose. The Thai entries mirror the visible plain-Thai
	// service language a buyer would search; the Latin entries name the actual
	// engineering skills, which visible copy may never say (site spec bans stack
	// names on the page). Structured data is the one surface where a hiring
	// company or an assistant can learn what he builds with.
	knowsAbout: [
		"รับทำเว็บไซต์ธุรกิจ",
		"ระบบจัดการงานและระบบหลังบ้านสำหรับธุรกิจ",
		"ระบบออเดอร์ สต๊อก ลูกค้า และงานในทีม",
		"ระบบสำหรับโรงงาน ร้านอาหาร โรงแรม และธุรกิจบริการ",
		"รับแก้เว็บที่สร้างด้วย AI",
		"TypeScript",
		"React",
		"Next.js",
		"Node.js",
		"Astro",
		"Python",
		"Ruby on Rails",
		"PostgreSQL",
		"Web performance and technical SEO",
		"Software architecture and system design",
	],
	// The engagement types he actually accepts, stated as structured data so a
	// company searching for contract help can match on it. Mirrors the visible
	// line in the reference zone; neither may claim more than the other.
	seeks: {
		"@type": "Demand",
		name: "งานพัฒนาระบบและเว็บไซต์ งานที่ปรึกษา และงานร่วมทีมแบบสัญญาจ้างตามระยะเวลา",
	},
	// URL normalises the Thai IDN to its xn-- form, which is what consumers of
	// structured data expect. Visible hrefs stay in readable Thai.
	sameAs: [
		// Only work that is actually serving on its domain. An entry without a
		// url is built but unpublished, so asserting it here would point search
		// engines and assistants at a site that does not answer.
		...works.flatMap((w) => (w.url ? [new URL(w.url).href] : [])),
		GITHUB_URL,
	],
};
---

<Layout
	title="รับทำเว็บไซต์ SME และระบบหลังบ้าน ทักไลน์คุยก่อนได้ | Pooh"
	description="รับทำเว็บไซต์และระบบหลังบ้านสำหรับ SME โรงงาน ร้านอาหาร โรงแรม และธุรกิจบริการ รวมออเดอร์ สต๊อก ลูกค้า งานในทีมไว้ที่เดียว มีผลงานที่เปิดใช้งานจริงให้ดูก่อนทัก โดยภูรินท์ ประสบการณ์กว่า 7 ปี ทักไลน์คุยก่อนได้ ไม่มีค่าใช้จ่าย"
	schema={personSchema}
>
	<section class="hero">
		<div class="shell hero-inner">
			<div class="hero-copy reveal reveal-eager">
				{/* The headline is the first thing on the page. The two chips that
				    used to sit above it (a Thai greeting and an English job title)
				    were the loudest element on a phone and read as a label stack
				    before the reader knew what was being offered. The greeting now
				    lives in the sub, and the job title stays in structured data
				    where it belongs. */}
				<h1>
					เปลี่ยนงานที่กระจัดกระจายและ<span class="nb">ไอเดีย</span>ในหัว
					ให้กลายเป็นเว็บไซต์และระบบที่<span class="mark">ใช้งานได้จริง</span>
				</h1>
				{/* Opens with the reader's own symptom, in the plain Thai the
				    /backoffice page uses, then answers it. Every visitor persona
				    recognised themselves in this sentence and none of them
				    recognised themselves in a job title. */}
				<p class="hero-sub">
					ออเดอร์เข้ามาหลายทาง สต๊อกไม่ตรง งานในทีมต้องไล่ถาม
					ผมช่วยรวบให้อยู่ที่เดียวและใช้งานได้จริง เริ่มจากงานเล็ก ๆ ก่อนก็ได้
					คุยก่อนไม่มีค่าใช้จ่าย
				</p>
				<div class="actions">
					<LineButton size="lg" />
					<a class="cta-quiet" href="/work">
						ดูผลงาน
						<Icon name="arrow" size={18} />
					</a>
				</div>
			</div>

			<div class="hero-photo reveal reveal-d1 reveal-eager">
				<div class="photo-frame">
					<ImagePlaceholder
						src={poohAtWork}
						alt="มาสคอตหมี Pooh สามมิติกำลังทำงานที่โต๊ะ"
						label="มาสคอต Pooh กำลังทำงาน"
						ratio="4 / 5"
						loading="eager"
						fetchpriority="high"
						sizes="(min-width: 68rem) 24rem, (min-width: 48rem) 36vw, calc(100vw - 2.75rem)"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="trust">
		<div class="shell">
			<ul class="trust-list">
				<li class="trust-item reveal">
					<span class="chip"><Icon name="badge" size={28} loading="eager" fetchpriority="low" /></span>
					<p>ประสบการณ์พัฒนาซอฟต์แวร์มากกว่า 7 ปี</p>
				</li>
				<li class="trust-item reveal reveal-d1">
					<span class="chip is-amber"><Icon name="spark" size={28} loading="eager" fetchpriority="low" /></span>
					<p>ผู้ก่อตั้ง <span class="nb">pawjai.co</span> ที่เปิดใช้งานจริง</p>
				</li>
				<li class="trust-item reveal reveal-d2">
					<span class="chip is-clay"><Icon name="plainwords" size={28} loading="eager" fetchpriority="low" /></span>
					<p>อธิบายด้วยภาษาที่คนทำธุรกิจเข้าใจ</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="section band-tint">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">สิ่งที่รับทำ</p>
				<h2>มาดูกันว่าเทคโนโลยีช่วยอะไรธุรกิจคุณได้บ้าง</h2>
				<p class="lede">
					ตั้งแต่หน้าร้านออนไลน์ ไปจนถึงงานเบื้องหลังที่ทีมใช้กันเอง
				</p>
			</div>

			<div class="offers">
				{
					offers.map((o, i) => (
						<a class:list={["offer", "reveal", `reveal-d${i}`]} href={o.href}>
							<span class:list={["chip", o.tint]}>
								<Icon name={o.icon} size={28} />
							</span>
							<h3>{o.title}</h3>
							<p>{o.body}</p>
							<span class="work-link offer-link">
								{o.linkLabel}
								<Icon name="arrow" size={16} />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section business-fit" aria-labelledby="business-fit-heading">
		<div class="shell fit-layout">
			<div class="fit-intro reveal">
				<p class="label">ระบบสำหรับธุรกิจ</p>
				<h2 id="business-fit-heading">เริ่มจากงานที่ทำให้ทีมเสียเวลามากที่สุด</h2>
				<p>
					ไม่ต้องเริ่มจากระบบใหญ่ครับ เลือกแก้ส่วนที่งานตกหล่น ข้อมูลไม่ตรงกัน
					หรือต้องคอยไล่ถามก่อน แล้วค่อยเชื่อมส่วนอื่นเมื่อเห็นว่าจำเป็น
				</p>
			</div>

			<div class="fit-content reveal reveal-d1">
				<p class="fit-heading">เลือกดูจากงานที่อยากจัดให้ชัด</p>
				<ul class="system-preview">
					{
						systemTypes.map((item, i) => (
							<li>
								<span class:list={["mini-icon", i % 3 === 1 && "is-amber", i % 3 === 2 && "is-clay"]}>
									<Icon name={item.icon} size={22} />
								</span>
								<span>{protectThai(item.title)}</span>
							</li>
						))
					}
				</ul>

				<div class="fit-next">
					<p>
						แนวทางนี้นำไปปรับใช้ได้กับโรงงาน ร้านอาหาร โรงแรม ธุรกิจบริการ
						และงานเฉพาะทางอื่น ๆ โดยเลือกเฉพาะส่วนที่ตรงกับวิธีทำงานจริง
					</p>
					<a class="work-link fit-detail-link" href="/backoffice">
						ดูตัวอย่างตามประเภทธุรกิจและระดับงาน
						<Icon name="arrow" size={16} />
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section band-cream wedge">
		<div class="shell wedge-inner">
			<div class="wedge-head reveal">
				<p class="label">สำหรับคนที่ลองให้ AI สร้างเองแล้ว</p>
				<h2>เว็บดูเหมือนใกล้เสร็จ แต่ยังเปิดใช้จริงไม่ได้ใช่ไหม</h2>
			</div>

			<div class="wedge-body reveal reveal-d1">
				<p class="wedge-lead">
					AI ช่วยให้เห็นหน้าตาและลองไอเดียได้เร็วครับ
					แต่ก่อนเปิดใช้จริงอาจยังติดเรื่องมือถือ ฟอร์ม การเข้าใช้งาน ความเร็ว หรือการค้นหาบน Google
				</p>
				<p class="wedge-lead">
					ผมรับตรวจและเก็บงานเฉพาะส่วน เมื่อของเดิมยังพอไปต่อและตีกรอบงานให้จบชัดเจนได้
					ถ้าแก้ต่อไม่คุ้มจะบอกตรง ๆ ก่อนเริ่ม
				</p>
				<p class="wedge-lead">
					บริการนี้รับเป็นงานครั้งต่อครั้ง ไม่ใช่งานเฝ้าระบบหรือดูแลรายเดือนแบบไม่มีกำหนด
				</p>
				<div class="wedge-actions">
					<LineButton size="lg" label="ส่งลิงก์ให้ผมประเมินก่อน" />
					<a class="wedge-more" href="/fix-ai-website"
						>ดูอาการที่รับแก้และงานที่อาจไม่เหมาะ</a
					>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">วิธีทำงาน</p>
				<h2>ทำงานเป็นขั้นตอน ให้รู้ตลอดว่าตอนนี้ถึงไหน</h2>
			</div>

			<ol class="steps">
				{
					steps.map((s, i) => (
						<li class:list={["step", "reveal", `reveal-d${i % 2}`]}>
							<span class="chip">
								<Icon name={s.icon} size={28} />
							</span>
							<div class="step-body">
								<p class="step-n">ขั้นที่ {s.n}</p>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section band-tint">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">ผลงานบางส่วน</p>
				<h2>ตัวอย่างงานที่ผ่านมา</h2>
			</div>

			<div class="work-list teaser">
				{
					featured.map((w, i) => (
						<article class:list={["work-item", "reveal", `reveal-d${i}`]}>
							<BrowserFrame
								domain={w.name}
								alt={w.alt}
								label={w.label}
								src={w.image}
								ratio="16 / 10"
							/>
							<span class:list={["tag", `is-${w.tint}`]}>{protectThai(w.kind)}</span>
							<h3>{w.name}</h3>
							<p>{protectThai(w.short)}</p>
							{w.url ? (
								<a
									class="work-link"
									href={w.url}
									target="_blank"
									rel="noopener"
								>
									เปิดดูเว็บไซต์
									<Icon name="external" size={16} />
								</a>
							) : (
								<p class="work-status">{protectThai(w.status ?? "")}</p>
							)}
						</article>
					))
				}
			</div>

			<p class="more reveal">
				และมีงานอื่นที่เล่าให้ฟังได้เมื่อทักมาคุย <a href="/work">ดูผลงานทั้งหมด</a>
			</p>
		</div>
	</section>

	<section class="section about">
		<div class="shell about-inner">
			<p class="label reveal">เกี่ยวกับผม</p>
			<div class="about-text reveal reveal-d1">
				<p>
					ผมภูรินท์ครับ ทำซอฟต์แวร์มากว่า 7 ปี
					ตอนนี้รับงานอิสระควบคู่กับการดูแล<span class="nb">โปรดักต์</span>ของตัวเอง
				</p>
				<p>
					คุณค่าไม่ได้อยู่ที่เครื่องมือ แต่อยู่ที่การเลือกใช้ให้ถูกจุดจนเกิดผลกับธุรกิจจริง
					<a href="/about">ดูเรื่องราวของผมเพิ่มเติม</a>
				</p>
				<p>
					งานแบ่งเป็นช่วงให้เห็น<span class="nb">ความคืบหน้า</span>ตลอด และหลังส่งมอบ
					ของทั้งหมดเป็นของลูกค้า
					เอาไปให้คนอื่นดูแลต่อได้เสมอครับ
				</p>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">ติดต่อ</p>
			<h2>มีงานในใจอยู่แล้ว หรือยังคิดไม่ออกก็ทักมาได้</h2>
