	}

	@media (min-width: 48em) {
		.trust {
			padding-bottom: 3.5rem;
		}

		/* Three across from tablet up: at 48em a 2-column grid left the third
		   item alone in a half-empty row. */
		.trust-list {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem 1.75rem;
			padding: 1.5rem 1.75rem;
		}
	}

	/* ---- offers ---- */

	.offers {
		display: grid;
		gap: 1.25rem;
	}

	.offer {
		display: grid;
		gap: 0.75rem;
		align-content: start;
		padding: 1.5rem;
		border-radius: var(--radius);
