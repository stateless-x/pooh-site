<style>
	/* ---- hero ---- */

	.hero-inner {
		display: grid;
		gap: 1.5rem;
		padding-block: 1.5rem 2.25rem;
	}

	/* Mobile source order IS the reading order: greeting, credential, headline,
	   the one-line claim, then the LINE button, and only then the portrait.
	   The portrait used to be lifted above the copy with order: -1, which spent
	   the entire first phone screen before the page had made a single claim and
	   left the only CTA 85px past the fold at 375x812 (and ~195px past a real
	   phone's usable fold after browser chrome). A Thai SME owner deciding in
	   one visit was being asked to scroll on faith. The portrait stays, it just
	   sits under the argument it supports; on the two-column tablet layout it
	   returns to the reader's right where there is room for both at once. */

	@media (max-width: 47.99em) {
		.photo-frame :global(.ph img) {
			aspect-ratio: 3 / 2;
			/* Below the fold now, so the crop can be a little taller than the
			   40vh it needed when it led the page. */
			max-height: 38vh;
			object-fit: cover;
		}
	}

	.hero-copy {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	/* Never wraps: the greeting is one short Thai phrase and breaking it after
	   "ผม" reads as a layout accident. When the row is tight it is .ident that
	   gives, at the wbr its markup provides. */
	.greet {
		display: inline-flex;
		align-items: center;
		align-self: start;
		justify-self: start;
		flex: none;
		white-space: nowrap;
		gap: 0.5rem;
		padding: 0.375rem 0.875rem 0.375rem 0.4375rem;
		border-radius: 999px;
		/* Cream surface with a honey hairline, NOT a honey tint: the pooh mark
		   sits inside this chip and the brand rules forbid placing the mark on
		   a similar honey-yellow background. */
		background: var(--cream);
		border: 1px solid rgba(243, 178, 26, 0.55);
		color: var(--ink);
		font-family: var(--font-head);
		font-weight: 500;
		font-size: var(--fs-body-sm);
	}

	.greet-bear {
		display: block;
		width: 1.375rem;
		height: 1.375rem;
		flex: none;
	}

	/* Wrapping is the default and the safe floor: at 320px the shell is 276px
	   and the greeting alone takes 177px, which leaves the credential too
	   little to break into without pushing the row past the viewport. */
	.hero-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.5rem;
	}

	/* From 23em up there is room for both on one row once .ident takes the break
	   its own markup provides. Held on one row rather than wrapped, the
	   credential stops spending a second row of the first phone screen on its
	   own full single-line width, and the LINE button moves up by that much. */
	@media (min-width: 23em) and (max-width: 47.99em) {
		.hero-badges {
			flex-wrap: nowrap;
		}
	}

	/* The English term is the attention-getter; the Thai line below carries
	   the meaning. Bordered rather than filled so it reads as a credential
	   next to the softer greeting chip.

	   min-width: 0 so the chip may shrink and take the wbr break in the markup
	   rather than holding its full single-line width. At 375px the greeting and
	   the credential together need 403px on one line, so without this the
	   credential dropped to a second row and spent ~49px of the first screen on
	   whitespace. Broken across its two words both chips share one row and the
	   LINE button moves up by that much. */
	.ident {
		/* inline-block, not inline-flex: as a flex container the .nb span and
		   the " Engineer" text node become flex items and the space between
		   them collapses, rendering "TechnologyEngineer". Inline-block keeps it
		   a normal text run, so the space survives and the line breaks only at
		   the space .nb leaves available. */
		display: inline-block;
		min-width: 0;
		padding: 0.375rem 0.875rem;
		border-radius: 999px;
		border: 1.5px solid var(--honey);
		background: var(--tint-honey);
		color: var(--honey-ink);
		font-family: var(--font-head);
		font-weight: 600;
		font-size: var(--fs-label);
		line-height: 1.35;
		letter-spacing: 0;
		text-align: center;
		/* Controlled break: the wbr in the markup is the only allowed break
		   point, so the term never splits mid-word the way anywhere allowed. */
		overflow-wrap: normal;
	}


	/* Thai display type wants MORE leading, not less: stacked vowels and tone
	   marks need vertical room, so this matches the global 1.35 rather than
	   tightening the way a Latin display headline would. */
	.hero h1 {
		display: grid;
		gap: 0.625rem;
		font-size: var(--fs-display);
		line-height: var(--lh-display);
		text-wrap: balance;
	}

	/* Carries the search phrase inside the h1 while the display line below
	   carries the emotional message. Styled like a section label so it reads
	   as a kicker rather than competing with the headline. */
	.h1-kicker {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--fs-label);
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.5;
		color: var(--accent);
	}

	.h1-kicker::before {
		content: "";
		width: 1.5rem;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
		opacity: 0.5;
		flex: none;
	}

	.h1-display {
		display: block;
	}

	/* Highlighter sweep. No rotation: that would force inline-block and stop
	   the phrase wrapping, which risks mid-word Thai breaks. Flat tint, never
	   a gradient. */
	.mark {
		background: var(--tint-strong);
		border-radius: 6px;
		padding: 0 0.25rem;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	/* Draw-in: a pseudo-element scales in from the left rather than animating
	   background-size, which cannot work on a flat colour.
	   Only from tablet up, and only when the phrase sits on a single line:
	   a pseudo covers the bounding box, not per-line fragments, so it would
	   smear across a wrapped phrase. Below 48em the flat tint shows as-is. */
	@media (min-width: 48em) and (prefers-reduced-motion: no-preference) {
		:global(html.js) .mark {
			position: relative;
			background: transparent;
			isolation: isolate;
		}

		:global(html.js) .mark::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: 6px;
			background: var(--tint-strong);
			transform: scaleX(0);
			transform-origin: left center;
			transition: transform 720ms cubic-bezier(0.22, 0.61, 0.36, 1) 240ms;
		}

		:global(html.js) .hero-copy.is-in .mark::before {
			transform: scaleX(1);
		}
	}

	.hero-sub {
		color: var(--muted);
		font-size: var(--fs-body);
		max-width: 32rem;
	}

	.hero .actions {
		margin-top: 0.5rem;
	}

	.photo-frame {
		position: relative;
		max-width: 22rem;
	}

	/* Offset accent border sitting behind the portrait. */
	.photo-frame::before {
		content: "";
		position: absolute;
		inset: 0;
		transform: translate(0.75rem, 0.75rem);
		border: 1.5px solid var(--accent);
		border-radius: var(--radius);
		opacity: 0.32;
		pointer-events: none;
	}

	.photo-frame :global(.ph) {
		position: relative;
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 48em) {
		.hero-inner {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 3.5rem;
			align-items: center;
			padding-block: 4rem 4.5rem;
