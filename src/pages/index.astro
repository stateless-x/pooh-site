---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import Icon from "../components/Icon.astro";
import LineButton from "../components/LineButton.astro";
import { works } from "../data/works";
import { protectThai } from "../utils/thai";
import { PERSON_NAME, PERSON_TITLE, GITHUB_URL, LINE_URL, LINE_ID } from "../../site.config.mjs";

// The home teaser shows three, in the order set by their teaser rank; /work
// carries the full set.
const featured = works
	.filter((w) => w.teaser)
	.sort((a, b) => a.teaser! - b.teaser!);

const offers = [
	{
		// The lowest-risk rung on the ladder: ปรึกษา -> สร้าง -> ดูแลต่อ.
		icon: "help",
		tint: "is-amber",
		title: "ปรึกษาด้านเทคโนโลยีและระบบ",
		body: "ยังไม่ต้องจ้างทำก็คุยได้ ช่วยดูว่าควรเริ่มตรงไหนและอะไรยังไม่ต้องทำตอนนี้",
	},
	{
		icon: "flow",
		tint: "is-clay",
		title: "ระบบสำหรับงานหลังบ้าน",
		body: "รวมงานที่กระจายอยู่ในไฟล์และแชท ให้เหลือที่เดียวที่ทีมใช้ร่วมกัน",
		href: "/backoffice",
		linkLabel: "ดูรายละเอียดระบบหลังบ้าน",
	},
	{
		icon: "storefront",
		tint: "",
		title: "เว็บไซต์ธุรกิจ",
		body: "ลูกค้าเข้าใจว่าคุณทำอะไรภายในไม่กี่วินาที และติดต่อกลับได้ง่าย",
	},
	{
		icon: "care",
		tint: "",
		title: "ดูแลและต่อยอด",
		body: "ส่งงานแล้วไม่ทิ้งงาน ปรับแก้และต่อยอดได้ตามที่ธุรกิจโตขึ้น",
	},
] as const;

const steps = [
	{
		n: "01",
		icon: "listen",
		title: "ฟังปัญหาก่อน",
		body: "ถามก่อนว่าติดขัดตรงไหน ยังไม่รีบเสนอวิธีทำ",
	},
	{
		n: "02",
		icon: "scope",
		title: "สรุปขอบเขตให้ชัด",
		body: "เขียนเป็นข้อ ๆ ว่าทำอะไรบ้างและใช้เวลาเท่าไร ตกลงกันก่อนลงมือ",
	},
	{
		n: "03",
		icon: "updates",
		title: "อัปเดตเป็นระยะ",
		body: "เห็นงานจริงเป็นช่วง ๆ ไม่ต้องรอจนจบถึงจะได้ดู",
	},
	{
		n: "04",
		icon: "deliver",
		title: "ส่งมอบพร้อมใช้จริง",
		body: "ส่งงานที่เปิดใช้ได้ทันที พร้อมวิธีดูแลต่อ",
	},
] as const;

// Only facts already stated on the page. No years, counts, or ratings.
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: PERSON_NAME,
	// The person is ภูรินท์; Pooh is the nickname and the site's name.
	alternateName: "Pooh",
	// Matches the visible hero chip exactly, so chip, schema, and spec agree.
	jobTitle: PERSON_TITLE,
	// Mirrors the visible canonical entity paragraph in the About strip.
	description:
		"ภูรินท์ (Pooh) คือนักพัฒนาเทคโนโลยีเพื่อธุรกิจ รับทำเว็บไซต์ธุรกิจ ระบบหลังบ้าน และรับปรึกษาด้านเทคโนโลยี มีประสบการณ์พัฒนาซอฟต์แวร์มากกว่า 7 ปี จบวิศวกรรมคอมพิวเตอร์จาก Mahidol University International College ปัจจุบันเป็นผู้ก่อตั้งและผู้พัฒนาหลักของ pawjai.co ควบคู่กับงานอิสระ อยู่กรุงเทพและทำงานร่วมกับลูกค้าได้ทั่วประเทศ ใช้ AI ช่วยให้งานเร็วขึ้นบนพื้นฐานวิศวกรรมที่ดูแลต่อได้ ติดต่อทางไลน์ bobroach",
	url: new URL("/", Astro.site).href,
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "Mahidol University International College",
	},
	address: {
		"@type": "PostalAddress",
		addressLocality: "Bangkok",
		addressCountry: "TH",
	},
	// Founder relationship to the SaaS he runs, stated as a real entity so the
	// project and the person are linkable rather than only named in prose.
	worksFor: {
		"@type": "Organization",
		name: "pawjai.co",
		url: "https://pawjai.co",
	},
	knowsAbout: [
		"รับทำเว็บไซต์ธุรกิจ",
		"ระบบหลังบ้านสำหรับธุรกิจ",
		"รับแก้เว็บที่สร้างด้วย AI",
	],
	// URL normalises the Thai IDN to its xn-- form, which is what consumers of
	// structured data expect. Visible hrefs stay in readable Thai.
	sameAs: [
		...works.map((w) => new URL(w.url).href),
		GITHUB_URL,
	],
};
---

<Layout
	title="รับทำระบบหลังบ้านและเว็บไซต์ธุรกิจ | Pooh"
	description="รับทำระบบหลังบ้านและเว็บไซต์ธุรกิจ พร้อมรับปรึกษาด้านเทคโนโลยีสำหรับ SME โดยภูรินท์ ประสบการณ์กว่า 7 ปี ส่งมอบพร้อมใช้จริงและดูแลต่อ ทักไลน์ bobroach"
	schema={personSchema}
>
	<section class="hero">
		<div class="shell hero-inner">
			<div class="hero-copy reveal reveal-eager">
				<div class="hero-badges">
					<p class="greet">
						<img
							class="greet-bear"
							src="/brand/pooh-mark.svg"
							alt=""
							width="1024"
							height="1024"
							aria-hidden="true"
						/>สวัสดีครับ ผมภูรินท์
					</p>
					<p class="ident" lang="en">Business Technology<wbr /> Engineer</p>
				</div>
				<h1>
					<span class="h1-kicker">รับทำระบบหลังบ้านและเว็บไซต์ธุรกิจ</span>
					<span class="h1-display"
						>เปลี่ยนงานที่กระจัดกระจายและ<span class="nb">ไอเดีย</span>ในหัว ให้กลายเป็นเว็บไซต์และระบบที่<span
							class="mark">ใช้งานได้จริง</span
						></span
					>
				</h1>
				{/* The AI-augmented tagline moved here from above the H1: the
				    pre-headline stack was three rows deep before the message arrived. */}
				<p class="hero-sub">
					ใช้ AI ให้ได้ความเร็ว บนพื้นฐานวิศวกรรมที่ดูแลต่อได้จริง
					ประสบการณ์พัฒนาซอฟต์แวร์มากกว่า 7 ปี ปัจจุบันรับงานอิสระและพัฒนา<span class="nb"
						>โปรดักต์</span
					>ของตัวเอง
				</p>
				<div class="actions">
					<LineButton size="lg" />
					<a class="cta-quiet" href="/work">
						ดูผลงาน
						<Icon name="arrow" size={18} />
					</a>
				</div>
			</div>

			<div class="hero-photo reveal reveal-d1 reveal-eager">
				<div class="photo-frame">
					<ImagePlaceholder
						alt="รูปถ่ายของภูรินท์"
						label="รูปถ่ายของภูรินท์ ยิ้มรับกล้อง"
						ratio="4 / 5"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="trust">
		<div class="shell">
			<ul class="trust-list">
				<li class="trust-item reveal">
					<span class="chip"><Icon name="badge" size={28} /></span>
					<p>ประสบการณ์พัฒนาซอฟต์แวร์มากกว่า 7 ปี</p>
				</li>
				<li class="trust-item reveal reveal-d1">
					<span class="chip is-amber"><Icon name="spark" size={28} /></span>
					<p>ผู้ก่อตั้ง <span class="nb">pawjai.co</span> ที่เปิดใช้งานจริง</p>
				</li>
				<li class="trust-item reveal reveal-d2">
					<span class="chip is-clay"><Icon name="plainwords" size={28} /></span>
					<p>อธิบายด้วยภาษาที่คนทำธุรกิจเข้าใจ</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="section band-tint">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">สิ่งที่รับทำ</p>
				<h2>มาดูกันว่าเทคโนโลยีช่วยอะไรธุรกิจคุณได้บ้าง</h2>
				<p class="lede">
					ตั้งแต่หน้าร้านออนไลน์ ไปจนถึงงานเบื้องหลังที่ทีมใช้กันเอง
				</p>
			</div>

			<div class="offers">
				{
					offers.map((o, i) => (
						<article class:list={["offer", "reveal", `reveal-d${i}`]}>
							<span class:list={["chip", o.tint]}>
								<Icon name={o.icon} size={28} />
							</span>
							<h3>{o.title}</h3>
							<p>{o.body}</p>
							{o.href && (
								<a class="work-link offer-link" href={o.href}>
									{o.linkLabel}
									<Icon name="arrow" size={16} />
								</a>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section band-cream wedge">
		<div class="shell wedge-inner">
			<div class="wedge-head reveal">
				<p class="label">สำหรับคนที่ลองให้ AI สร้างเองแล้ว</p>
				<h2>ให้ AI สร้างให้ทั้งหมด เร็วจริง แต่พอพังแล้วใครแก้</h2>
			</div>

			<div class="wedge-body reveal reveal-d1">
				<p class="wedge-lead">
					ใครก็สั่งให้ AI สร้างเว็บขึ้นมาได้ในไม่กี่ชั่วโมง บางคนเรียกกันว่า <span
						lang="en">Vibe Coding</span
					> เห็นผลไวจนรู้สึกว่าใกล้เสร็จ แต่พอมีคนใช้จริงแล้วเริ่มรวน คำถามคือใครแก้ให้
					ผมใช้ AI ทำงานทุกวันเหมือนกันครับ แต่ใช้แบบวิศวกร
					คือให้ AI ช่วยเรื่องความเร็ว ส่วนโครงสร้างและความปลอดภัยมาจากประสบการณ์จริง
					ถ้ามีของทำค้างไว้ ส่งมาให้ผมดูได้เลย ไม่ต้องรื้อทิ้งเริ่มใหม่
				</p>
				<div class="wedge-actions">
					<LineButton size="lg" label="ส่งของที่ทำค้างไว้มาคุยกัน" />
					<a class="wedge-more" href="/fix-ai-website"
						>อ่านแนวทางเต็ม ๆ และ<span class="nb">เช็กลิสต์</span> 8 ข้อ</a
					>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">วิธีทำงาน</p>
				<h2>ทำงานเป็นขั้นตอน ให้รู้ตลอดว่าตอนนี้ถึงไหน</h2>
			</div>

			<ol class="steps">
				{
					steps.map((s, i) => (
						<li class:list={["step", "reveal", `reveal-d${i % 2}`]}>
							<span class="chip">
								<Icon name={s.icon} size={28} />
							</span>
							<div class="step-body">
								<p class="step-n">ขั้นที่ {s.n}</p>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section band-tint">
		<div class="shell">
			<div class="section-head reveal">
				<p class="label">ผลงานบางส่วน</p>
				<h2>ตัวอย่างงานที่ผ่านมา</h2>
			</div>

			<div class="work-list teaser">
				{
					featured.map((w, i) => (
						<article class:list={["work-item", "reveal", `reveal-d${i}`]}>
							<BrowserFrame
								domain={w.name}
								alt={w.alt}
								label={w.label}
								ratio="16 / 10"
							/>
							<span class:list={["tag", `is-${w.tint}`]}>{protectThai(w.kind)}</span>
							<h3>{w.name}</h3>
							<p>{protectThai(w.short)}</p>
							<a class="work-link" href={w.url}>
								เปิดดูเว็บไซต์
								<Icon name="external" size={16} />
							</a>
						</article>
					))
				}
			</div>

			<p class="more reveal">
				และมีงานอื่นที่เล่าให้ฟังได้เมื่อทักมาคุย <a href="/work">ดูผลงานทั้งหมด</a>
			</p>
		</div>
	</section>

	<section class="section about">
		<div class="shell about-inner">
			<p class="label reveal">เกี่ยวกับผม</p>
			<div class="about-text reveal reveal-d1">
				<p>
					ผมภูรินท์ครับ ทำซอฟต์แวร์มากว่า 7 ปี เคยร่วมทีมพัฒนาที่ Agoda มาก่อน
					ตอนนี้รับงานอิสระควบคู่กับการดูแล<span class="nb">โปรดักต์</span>ของตัวเอง
				</p>
				<p>
					คุณค่าไม่ได้อยู่ที่เครื่องมือ แต่อยู่ที่การเลือกใช้ให้ถูกจุดจนเกิดผลกับธุรกิจจริง
				</p>
				<p>
					งานแบ่งเป็นช่วงให้เห็น<span class="nb">ความคืบหน้า</span>ตลอด และหลังส่งมอบ
					ของทั้งหมดเป็นของลูกค้า
					เอาไปให้คนอื่นดูแลต่อได้เสมอครับ
				</p>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="shell band-inner reveal">
			<p class="label">ติดต่อ</p>
			<h2>มีงานในใจอยู่แล้ว หรือยังคิดไม่ออกก็ทักมาได้</h2>
			<p class="lede">
				เล่าคร่าว ๆ ว่าทำธุรกิจอะไรและอยากให้ช่วยเรื่องไหน ผมตอบเองทุกข้อความ
				ถ้าเรื่องไหนไม่ถนัดจะบอกตรง ๆ ครับ
			</p>
			{/* Capacity is a real constraint for a solo developer, so it is stated
			    plainly. No countdown, no slot counter, nothing invented. */}
			<p class="band-note">
				ผมรับงานได้จำนวนจำกัดในแต่ละช่วง เพื่อให้ดูแลทุกงานได้เต็มที่
			</p>
			<div class="actions">
				<LineButton size="lg" />
				<a class="cta-quiet" href="/contact">
					ดูวิธีติดต่อ
					<Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	{/* Quiet reference zone. Long keyword-rich prose lives here rather than at
	    the top of the page, where the owner wanted everything skimmable. The
	    canonical entity paragraph moved here from the About strip; the Person
	    JSON-LD description above still mirrors it verbatim. */}
	<section class="seo-zone" aria-labelledby="seo-zone-heading">
		<div class="shell seo-inner">
			<h2 class="label" id="seo-zone-heading">เกี่ยวกับบริการ</h2>
			<div class="seo-cols">
				<div class="seo-col">
					<p>
						<strong>ภูรินท์ (Pooh) คือนักพัฒนาเทคโนโลยีเพื่อธุรกิจ รับทำเว็บไซต์ธุรกิจและระบบหลังบ้าน</strong>
						มีประสบการณ์พัฒนาซอฟต์แวร์มากกว่า 7 ปี จบวิศวกรรมคอมพิวเตอร์จาก Mahidol University
						International College ปัจจุบันเป็นผู้ก่อตั้งและผู้พัฒนาหลักของ
						<a href="https://pawjai.co">pawjai.co</a> ควบคู่กับงานอิสระ
						อยู่กรุงเทพและทำงานร่วมกับลูกค้าได้ทั่วประเทศ ใช้ AI
						ช่วยให้งานเร็วขึ้นบนพื้นฐานวิศวกรรมที่ดูแลต่อได้ ติดต่อทางไลน์ bobroach
					</p>
					<p>
						<strong>รับทำระบบสำหรับงานหลังบ้าน</strong>
						เปลี่ยนงานที่กระจายอยู่ในไฟล์และแชท
						ให้กลายเป็นที่เดียวที่ทีมเปิดดูร่วมกันได้ รู้ว่าใครทำอะไรถึงไหนโดยไม่ต้องไล่ถาม
						เหมาะกับธุรกิจที่เริ่มโตจนจดใส่กระดาษหรือไฟล์ไม่ไหวแล้ว
						หลังส่งมอบยังปรับแก้และเพิ่มของใหม่ได้ตามที่ธุรกิจโตขึ้น ไม่ปล่อยให้ค้างอยู่ที่เดิม <a href="/backoffice">ดูรายละเอียดหน้าระบบหลังบ้าน</a>
					</p>
				</div>
				<div class="seo-col">
					<p>
						<strong>รับปรึกษาด้านเทคโนโลยีและระบบหลังบ้าน</strong>
						สำหรับเจ้าของธุรกิจที่ยังไม่แน่ใจว่าควรสร้างอะไรก่อน ทีมที่มีระบบอยู่แล้วแต่ไปต่อไม่ถูก
						หรือคนที่อยากได้คนกลางช่วยคุยกับทีมพัฒนาให้เข้าใจตรงกัน
						เป็นที่ปรึกษาระบบหลังบ้านที่พูดภาษาธุรกิจได้ ไม่ต้องจ้างทำก็คุยกันก่อนได้ อยากรู้เรื่องงบ <a href="/budget-factors">ดูว่างบขึ้นกับอะไรบ้าง</a>
					</p>
					<p>
