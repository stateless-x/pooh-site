<style>
	/* ---- hero ---- */

	.hero-inner {
		display: grid;
		gap: 1.5rem;
		padding-block: 1.5rem 2.25rem;
	}

	/* Mobile source order IS the reading order: greeting, credential, headline,
	   the one-line claim, then the LINE button, and only then the portrait.
	   The portrait used to be lifted above the copy with order: -1, which spent
	   the entire first phone screen before the page had made a single claim and
	   left the only CTA 85px past the fold at 375x812 (and ~195px past a real
	   phone's usable fold after browser chrome). A Thai SME owner deciding in
	   one visit was being asked to scroll on faith. The portrait stays, it just
	   sits under the argument it supports; on the two-column tablet layout it
	   returns to the reader's right where there is room for both at once. */

	@media (max-width: 47.99em) {
		.photo-frame :global(.ph img) {
			aspect-ratio: 3 / 2;
			/* Below the fold now, so the crop can be a little taller than the
			   40vh it needed when it led the page. */
			max-height: 38vh;
			object-fit: cover;
		}
	}

	.hero-copy {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	/* Thai display type wants MORE leading, not less: stacked vowels and tone
	   marks need vertical room, so this matches the global 1.35 rather than
	   tightening the way a Latin display headline would. */
	.hero h1 {
		font-size: var(--fs-display);
		line-height: var(--lh-display);
		text-wrap: balance;
	}

	/* Highlighter sweep. No rotation: that would force inline-block and stop
	   the phrase wrapping, which risks mid-word Thai breaks. Flat tint, never
	   a gradient. */
	.mark {
		background: var(--tint-strong);
		border-radius: 6px;
		padding: 0 0.25rem;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	/* Draw-in: a pseudo-element scales in from the left rather than animating
	   background-size, which cannot work on a flat colour.
	   Only from tablet up, and only when the phrase sits on a single line:
	   a pseudo covers the bounding box, not per-line fragments, so it would
	   smear across a wrapped phrase. Below 48em the flat tint shows as-is. */
	@media (min-width: 48em) and (prefers-reduced-motion: no-preference) {
		:global(html.js) .mark {
			position: relative;
			background: transparent;
			isolation: isolate;
		}

		:global(html.js) .mark::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: 6px;
			background: var(--tint-strong);
			transform: scaleX(0);
			transform-origin: left center;
			transition: transform 720ms cubic-bezier(0.22, 0.61, 0.36, 1) 240ms;
		}

		:global(html.js) .hero-copy.is-in .mark::before {
			transform: scaleX(1);
		}
	}

	.hero-sub {
		color: var(--muted);
		font-size: var(--fs-body);
		max-width: 32rem;
	}

	.hero .actions {
		margin-top: 0.5rem;
	}

	.photo-frame {
		position: relative;
		max-width: 22rem;
	}

	/* Offset accent border sitting behind the portrait. */
	.photo-frame::before {
		content: "";
		position: absolute;
		inset: 0;
		transform: translate(0.75rem, 0.75rem);
		border: 1.5px solid var(--accent);
		border-radius: var(--radius);
		opacity: 0.32;
		pointer-events: none;
	}

	.photo-frame :global(.ph) {
		position: relative;
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 48em) {
		.hero-inner {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 3.5rem;
			align-items: center;
			padding-block: 4rem 4.5rem;
		}

		.photo-frame {
			max-width: none;
			margin-left: auto;
		}

	}

	/* ---- trust strip ---- */

	.trust {
		padding-bottom: 2.5rem;
	}

	.trust-list {
		display: grid;
		gap: 0.875rem;
		padding: 1.25rem;
		border-radius: var(--radius);
		background: var(--paper);
		border: 1px solid var(--rule-soft);
		box-shadow: var(--shadow-sm);
	}

	.trust-item {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.trust-item p {
		font-family: var(--font-head);
		font-weight: 500;
		font-size: var(--fs-body-sm);
		line-height: 1.5;
		min-width: 0;
	}

	@media (min-width: 48em) {
		.trust {
			padding-bottom: 3.5rem;
		}

		/* Three across from tablet up: at 48em a 2-column grid left the third
		   item alone in a half-empty row. */
		.trust-list {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem 1.75rem;
			padding: 1.5rem 1.75rem;
		}
	}

	/* ---- offers ---- */

	.offers {
		display: grid;
		gap: 1.25rem;
	}

	.offer {
		display: grid;
		gap: 0.75rem;
		align-content: start;
		padding: 1.5rem;
		border-radius: var(--radius);
		background: var(--paper);
		border: 1px solid var(--rule-soft);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
		transition:
			transform 220ms ease,
			box-shadow 220ms ease;
	}

	@media (hover: hover) {
		.offer:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-md);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.offer {
			transition: none;
		}

		.offer:hover {
			transform: none;
		}
	}

	.offer-link {
		margin-top: auto;
		padding-top: 0.25rem;
		font-size: var(--fs-body-sm);
	}

	.offer h3 {
		font-size: var(--fs-subtitle);
	}

	.offer p {
		color: var(--muted);
		font-size: var(--fs-body-sm);
