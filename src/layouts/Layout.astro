---
import AssetImage from "../components/AssetImage.astro";
import LineButton from "../components/LineButton.astro";
import poohLockup from "../assets/brand/pooh-lockup-horizontal.svg";
import poohMark from "../assets/brand/pooh-mark.svg";
import poohWordmark from "../assets/brand/pooh-wordmark.svg";
import {
	SITE_NAME,
	PERSON_NAME,
	IDENTITY_PHRASE,
	LINE_URL,
	GITHUB_URL,
} from "../../site.config.mjs";

interface Props {
	title: string;
	description: string;
	/** Extra structured data for this page, serialised into JSON-LD. */
	schema?: Record<string, unknown> | Record<string, unknown>[];
	/** Keep the page out of search results (used by 404). */
	noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

// Every absolute URL derives from `site` in astro.config.mjs, which currently
// holds a placeholder the owner must replace before deploy.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const schemaBlocks = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Header nav carries the priority service and content pages. Labels are the shortest
// form that still names the destination.
//
// หน้าแรก is deliberately absent: adding it to these five items wraps too deeply
// on narrow no-JS layouts
// (measured), and dropping a destination would have been worse than dropping a
// link the logo already provides. The logo carries aria-label "Pooh หน้าแรก",
// so home stays reachable and named for assistive tech.
const nav = [
	{ href: "/backoffice", label: "ระบบธุรกิจ" },
	{ href: "/budget-factors", label: "งบประมาณ" },
	{ href: "/work", label: "ผลงาน" },
	{ href: "/blog", label: "บทความ" },
	{ href: "/contact", label: "ติดต่อ" },
];

// The footer still lists home explicitly, where there is room for it.
const footNav = [
	{ href: "/", label: "หน้าแรก" },
	...nav,
	{ href: "/about", label: "เกี่ยวกับผม" },
	{ href: "/fix-ai-website", label: "รับแก้เว็บที่สร้างด้วย AI" },
];

---

<html lang="th">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* Full icon set. The SVG leads for modern browsers; the .ico carries
		    the legacy sizes; the PNGs cover Android and iOS home screens. */}
		<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
		<link rel="icon" href="/brand/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
		<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{/* Matches the page background so browser chrome blends in. The
		    manifest keeps honey as the brand theme colour. */}
		<meta name="theme-color" content="#FFF9ED" />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="th_TH" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		{/* TODO (owner): add a 1200x630 image at public/og.png. */}
		<meta property="og:image" content={ogImage.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${PERSON_NAME} ${IDENTITY_PHRASE} รับทำเว็บไซต์และระบบสำหรับธุรกิจ`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
		{
			schemaBlocks.map((block) => (
				<script
					type="application/ld+json"
					is:inline
					set:html={JSON.stringify(block)}
				/>
			))
		}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Mitr:wght@500;600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500&display=swap"
		/>
		{/* Marks that JS is available, so the reveal's hidden start state only
		    ever applies when something can actually reveal it again. */}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<a class="skip" href="#main">ข้ามไปยังเนื้อหาหลัก</a>

		<header class="site-head">
			<div class="shell head-inner">
				{/* Lockup at 44px tall renders 110px wide, clearing the brand's
				    100px minimum. Below 26em the header is too tight for that, so
				    the mark alone is used, per the same rule. */}
				<a class="site-logo-link" href="/" aria-label="Pooh หน้าแรก">
					<AssetImage
						class="site-logo site-logo-lockup"
						src={poohLockup}
						alt="Pooh"
						width="600"
						height="240"
						loading="eager"
					/>
					<AssetImage
						class="site-logo site-logo-mark"
						src={poohMark}
						alt="Pooh"
						width="1024"
						height="1024"
						loading="eager"
					/>
				</a>
				{/* Inline nav is the DEFAULT and the no-JS fallback: without the
				    js class it simply renders as a normal row at every width, which
				    keeps the existing no-JS guarantee with no checkbox hack. The
				    drawer only takes over once JS has marked the document. */}
				<nav class="nav-inline" aria-label="เมนูหลัก">
					<ul>
						{
							nav.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={path === item.href ? "page" : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				{/* The decision to message can land anywhere on a long page, so the
				    action rides along in the sticky header at every width. It is
				    deliberately NOT the green LINE button: a second full-strength
				    button competes with the page's own CTA and puts the loudest
				    colour on the site above the logo. An outlined cocoa pill
				    reads as part of the header, and green stays the one colour
				    that means "this is the action". */}
				<a class="head-cta" href={LINE_URL}>
					<span class="head-cta-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" focusable="false">
							<path
								d="M12 3.2c-5 0-9 3.2-9 7.2 0 3.6 3 6.6 7.1 7.1.3.06.6.2.7.4.1.2.06.5.03.7l-.1.7c-.04.2-.2.9.7.5s4.9-2.9 6.7-5c1.2-1.3 1.8-2.7 1.8-4.4 0-4-4-7.2-9-7.2Z"
								fill="currentColor"></path>
						</svg>
					</span>
					<span class="head-cta-label">ทักไลน์</span>
				</a>

				<button
					class="nav-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="nav-drawer"
					aria-label="เปิดเมนู"
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						aria-hidden="true"
						focusable="false"
					>
						<path d="M3.75 6.75h16.5" />
						<path d="M3.75 12h16.5" />
						<path d="M3.75 17.25h16.5" />
					</svg>
				</button>
			</div>
		</header>

		<div class="nav-overlay" hidden></div>

		<div class="nav-drawer" id="nav-drawer" hidden>
			<div class="drawer-head">
				<a class="drawer-brand" href="/" aria-label={`${SITE_NAME} หน้าแรก`}>
					<AssetImage
						class="drawer-bear"
						src={poohMark}
						alt=""
						width="1024"
						height="1024"
						loading="lazy"
						aria-hidden="true"
					/>
					<AssetImage
						class="drawer-wordmark"
						src={poohWordmark}
						alt={SITE_NAME}
						width="2258"
						height="1116"
						loading="lazy"
					/>
				</a>
				<button class="drawer-close" type="button" aria-label="ปิดเมนู">
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						aria-hidden="true"
						focusable="false"
					>
						<path d="M6 6l12 12" />
						<path d="M18 6L6 18" />
					</svg>
				</button>
			</div>

			<nav class="drawer-nav" aria-label="เมนูในลิ้นชัก">
				<ul>
					<li>
						<a href="/" aria-current={path === "/" ? "page" : undefined}>หน้าแรก</a>
					</li>
					{
						footNav.slice(1).map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={path === item.href ? "page" : undefined}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			{/* Square icon pair rather than a full-width button: the drawer is
			    already a list of text rows, so two 1:1 tiles read as "ช่องทาง"
			    instead of a third nav item. LINE keeps its own green; GitHub
			    stays in the header's ink so the green still means one thing. */}
			<div class="drawer-foot">
				<a class="drawer-icon is-line" href={LINE_URL} aria-label="ทักไลน์">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
						<path
							d="M12 3.2c-5 0-9 3.2-9 7.2 0 3.6 3 6.6 7.1 7.1.3.06.6.2.7.4.1.2.06.5.03.7l-.1.7c-.04.2-.2.9.7.5s4.9-2.9 6.7-5c1.2-1.3 1.8-2.7 1.8-4.4 0-4-4-7.2-9-7.2Z"
							fill="currentColor"></path>
					</svg>
				</a>
				<a
					class="drawer-icon"
					href={GITHUB_URL}
					target="_blank"
					rel="noopener"
					aria-label="ดูตัวอย่างโค้ดบน GitHub"
				>
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
						<path
							d="M12 2.6a9.4 9.4 0 0 0-3 18.3c.5.1.6-.2.6-.5v-1.7c-2.6.6-3.2-1.2-3.2-1.2-.4-1.1-1-1.4-1-1.4-.9-.6.06-.6.06-.6 1 .07 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.8.85.1-.6.35-1.1.6-1.35-2.1-.25-4.3-1.05-4.3-4.65 0-1.05.35-1.85.95-2.55-.1-.25-.4-1.2.1-2.5 0 0 .8-.25 2.6.95a9 9 0 0 1 4.7 0c1.8-1.2 2.6-.95 2.6-.95.5 1.3.2 2.25.1 2.5.6.7.95 1.5.95 2.55 0 3.6-2.2 4.4-4.3 4.65.35.3.65.9.65 1.8v2.7c0 .3.15.6.65.5A9.4 9.4 0 0 0 12 2.6Z"
							fill="currentColor"></path>
					</svg>
				</a>
			</div>
		</div>

		<main id="main">
			<slot />
		</main>

		<footer class="site-foot">
			<div class="shell foot-inner">
				<div class="foot-brand">
					{/* The real wordmark outlines, not live text: the header lockup
					    uses these same Avenir-derived letterforms, and Mitr 600 next to
					    them read as two different brands. Inlined so fill can follow
					    currentColor for the cream-on-cocoa footer. Mark-to-wordmark gap
					    and relative height match the lockup's own geometry. */}
					<div class="foot-mark" role="img" aria-label="Pooh">
						<AssetImage
							class="foot-bear"
							src={poohMark}
							alt=""
							width="1024"
							height="1024"
							loading="lazy"
							aria-hidden="true"
						/>
						<svg
							class="foot-wordmark"
							viewBox="0 0 2258 1116"
							aria-hidden="true"
							focusable="false"
						>
							<path fill="currentColor" d="M463.00 558.00Q463.00 519.00 450.50 485.00Q438.00 451.00 415.00 426.00Q392.00 401.00 359.50 386.50Q327.00 372.00 286.00 372.00Q245.00 372.00 211.00 386.50Q177.00 401.00 152.00 426.00Q127.00 451.00 113.00 485.00Q99.00 519.00 99.00 558.00Q99.00 597.00 113.00 631.00Q127.00 665.00 152.00 690.00Q177.00 715.00 211.00 729.50Q245.00 744.00 286.00 744.00Q327.00 744.00 359.50 729.50Q392.00 715.00 415.00 690.00Q438.00 665.00 450.50 631.00Q463.00 597.00 463.00 558.00ZM36.00 324.00L102.00 324.00L102.00 402.00L104.00 402.00Q120.00 378.00 142.00 361.00Q164.00 344.00 188.00 333.00Q212.00 322.00 237.50 317.00Q263.00 312.00 286.00 312.00Q341.00 312.00 386.50 330.50Q432.00 349.00 465.00 382.00Q498.00 415.00 516.50 460.00Q535.00 505.00 535.00 558.00Q535.00 611.00 516.50 656.00Q498.00 701.00 465.00 734.00Q432.00 767.00 386.50 785.50Q341.00 804.00 286.00 804.00Q263.00 804.00 237.50 799.00Q212.00 794.00 188.00 783.00Q164.00 772.00 142.00 755.00Q120.00 738.00 104.00 714.00L102.00 714.00L102.00 1080.00L36.00 1080.00ZM1044.00 558.00Q1044.00 519.00 1031.50 485.00Q1019.00 451.00 996.00 426.00Q973.00 401.00 940.50 386.50Q908.00 372.00 867.00 372.00Q826.00 372.00 793.50 386.50Q761.00 401.00 738.50 426.00Q716.00 451.00 703.50 485.00Q691.00 519.00 691.00 558.00Q691.00 597.00 703.50 631.00Q716.00 665.00 738.50 690.00Q761.00 715.00 793.50 729.50Q826.00 744.00 867.00 744.00Q908.00 744.00 940.50 729.50Q973.00 715.00 996.00 690.00Q1019.00 665.00 1031.50 631.00Q1044.00 597.00 1044.00 558.00ZM1116.00 558.00Q1116.00 611.00 1097.50 656.00Q1079.00 701.00 1046.00 734.00Q1013.00 767.00 967.50 785.50Q922.00 804.00 867.00 804.00Q813.00 804.00 767.50 785.50Q722.00 767.00 689.00 734.00Q656.00 701.00 637.50 656.00Q619.00 611.00 619.00 558.00Q619.00 505.00 637.50 460.00Q656.00 415.00 689.00 382.00Q722.00 349.00 767.50 330.50Q813.00 312.00 867.00 312.00Q922.00 312.00 967.50 330.50Q1013.00 349.00 1046.00 382.00Q1079.00 415.00 1097.50 460.00Q1116.00 505.00 1116.00 558.00ZM1633.00 558.00Q1633.00 519.00 1620.50 485.00Q1608.00 451.00 1585.00 426.00Q1562.00 401.00 1529.50 386.50Q1497.00 372.00 1456.00 372.00Q1415.00 372.00 1382.50 386.50Q1350.00 401.00 1327.50 426.00Q1305.00 451.00 1292.50 485.00Q1280.00 519.00 1280.00 558.00Q1280.00 597.00 1292.50 631.00Q1305.00 665.00 1327.50 690.00Q1350.00 715.00 1382.50 729.50Q1415.00 744.00 1456.00 744.00Q1497.00 744.00 1529.50 729.50Q1562.00 715.00 1585.00 690.00Q1608.00 665.00 1620.50 631.00Q1633.00 597.00 1633.00 558.00ZM1705.00 558.00Q1705.00 611.00 1686.50 656.00Q1668.00 701.00 1635.00 734.00Q1602.00 767.00 1556.50 785.50Q1511.00 804.00 1456.00 804.00Q1402.00 804.00 1356.50 785.50Q1311.00 767.00 1278.00 734.00Q1245.00 701.00 1226.50 656.00Q1208.00 611.00 1208.00 558.00Q1208.00 505.00 1226.50 460.00Q1245.00 415.00 1278.00 382.00Q1311.00 349.00 1356.50 330.50Q1402.00 312.00 1456.00 312.00Q1511.00 312.00 1556.50 330.50Q1602.00 349.00 1635.00 382.00Q1668.00 415.00 1686.50 460.00Q1705.00 505.00 1705.00 558.00ZM1821.00 36.00L1887.00 36.00L1887.00 399.00L1889.00 399.00Q1900.00 380.00 1917.00 364.00Q1934.00 348.00 1955.00 336.50Q1976.00 325.00 1999.50 318.50Q2023.00 312.00 2046.00 312.00Q2136.00 312.00 2179.00 359.50Q2222.00 407.00 2222.00 495.00L2222.00 792.00L2156.00 792.00L2156.00 533.00Q2156.00 455.00 2129.00 413.50Q2102.00 372.00 2029.00 372.00Q2024.00 372.00 2001.00 376.00Q1978.00 380.00 1952.50 398.00Q1927.00 416.00 1907.00 452.00Q1887.00 488.00 1887.00 552.00L1887.00 792.00L1821.00 792.00Z" />
						</svg>
					</div>
					<p class="foot-note">
						รับงานอิสระ ออกแบบและพัฒนาเว็บไซต์และระบบสำหรับธุรกิจ
					</p>
					<nav class="foot-nav" aria-label="เมนูท้ายหน้า">
						<ul>
							{
								footNav.map((item) => (
									<li>
										<a href={item.href}>{item.label}</a>
									</li>
								))
							}
						</ul>
					</nav>
				</div>
				<div class="foot-cta">
					<p class="foot-cta-label">คุยกันได้เลยครับ</p>
					<LineButton />
					<p class="foot-note">ไลน์ส่วนตัว ตอบเองทุกข้อความ</p>
				</div>
			</div>
		</footer>

		<button class="back-to-top" type="button" aria-label="กลับไปด้านบน" data-back-to-top>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
				<path d="M12 19V5" />
				<path d="m6.5 10.5 5.5-5.5 5.5 5.5" />
			</svg>
		</button>

		<script is:inline>
			(function () {
				var els = document.querySelectorAll(".reveal");
				if (!els.length) return;

				var reduced =
					window.matchMedia &&
					window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				// Reduced motion or no observer support: show everything at once.
				if (reduced || !("IntersectionObserver" in window)) {
					for (var i = 0; i < els.length; i++) els[i].classList.add("is-in");
					return;
				}

				// Above-the-fold elements are revealed on a timer rather than by the
				// observer. The observer fires almost immediately for them, which can
				// coalesce with first paint so the browser never sees a start state to
				// transition FROM. Two frames guarantee the initial style is committed
				// first, so the hero actually animates in (highlight sweep included).
				var eager = document.querySelectorAll(".reveal-eager");

				requestAnimationFrame(function () {
					requestAnimationFrame(function () {
						for (var i = 0; i < eager.length; i++) {
							eager[i].classList.add("is-in");
						}
					});
				});

				function show(el) {
					el.classList.add("is-in");
					io.unobserve(el);
				}

				var io = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (entry) {
							if (entry.isIntersecting) {
								show(entry.target);
								return;
							}
							// Not intersecting AND entirely above the viewport: the
							// visitor arrived past this element rather than scrolling
							// through it (back-navigation scroll restoration, an
							// anchor jump, a reload with a restored offset). Without
							// this branch the observer would never fire for it again
							// and it would sit at opacity 0 in content the visitor has
							// already passed, invisible until scrolled out and back in.
							if (entry.boundingClientRect.bottom < 0) show(entry.target);
						});
					},
					// threshold 0 with no negative rootMargin: any pixel on screen
					// counts. The old 0.06 / -8% pair widened the band in which an
					// element is on screen but not yet considered visible, which is
					// dead zone rather than polish.
					{ threshold: 0 }
				);

				els.forEach(function (el) {
					if (el.classList.contains("reveal-eager")) return;
					io.observe(el);
				});

				// Restoring from the back/forward cache does not re-run this script,
				// and the browser restores the scroll offset without firing the
				// observer for what is already on screen. Sweep on every pageshow
				// (persisted or not) and reveal anything at or above the fold.
				window.addEventListener("pageshow", function () {
					var pending = document.querySelectorAll(".reveal:not(.is-in)");
					for (var i = 0; i < pending.length; i++) {
						var el = pending[i];
						if (el.getBoundingClientRect().top < window.innerHeight) show(el);
					}
				});
			})();
		</script>

		<script is:inline>
			(function () {
				var button = document.querySelector("[data-back-to-top]");
				if (!button) return;

				function update() {
					button.classList.toggle("is-visible", window.scrollY > Math.max(640, window.innerHeight * 1.2));
				}

				window.addEventListener("scroll", update, { passive: true });
				window.addEventListener("pageshow", update);
				update();

				button.addEventListener("click", function () {
					window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
				});
			})();
		</script>

		<script is:inline>
			(function () {
				var toggle = document.querySelector(".nav-toggle");
				var drawer = document.getElementById("nav-drawer");
				var overlay = document.querySelector(".nav-overlay");
				var closeBtn = document.querySelector(".drawer-close");
				if (!toggle || !drawer || !overlay) return;

				var lastFocused = null;
				var closeTimer = null;

				function focusables() {
