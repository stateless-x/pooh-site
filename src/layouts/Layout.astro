				display: block;
				height: 1.6875rem;
				width: auto;
			}

			.drawer-close {
				display: grid;
				place-items: center;
				width: 44px;
				height: 44px;
				margin-right: -0.5rem;
				padding: 0;
				border: 0;
				border-radius: 10px;
				background: transparent;
				color: var(--ink);
				cursor: pointer;
			}

			.drawer-close svg {
				width: 22px;
				height: 22px;
			}

			.drawer-nav ul {
				display: grid;
				gap: 0.125rem;
			}

			.drawer-nav a {
				display: flex;
				align-items: center;
				min-height: 48px;
				padding: 0.25rem 0.5rem;
				border-radius: 10px;
				font-family: var(--font-head);
				font-weight: 500;
				font-size: var(--fs-subtitle);
				color: var(--ink);
				text-decoration: none;
			}

			.drawer-nav a[aria-current="page"] {
				background: var(--tint-strong);
				color: var(--cocoa);
			}

			.drawer-foot {
				margin-top: auto;
				padding-top: 0.875rem;
				border-top: 1px solid var(--rule-soft);
				display: flex;
				gap: 0.625rem;
			}

			/* 1:1 tiles. aspect-ratio rather than a fixed height so the pair keeps
			   its square regardless of the icon inside. */
			.drawer-icon {
				display: grid;
				place-items: center;
				width: 52px;
				aspect-ratio: 1;
				border-radius: 12px;
				border: 1px solid var(--rule);
				background: var(--paper);
				color: var(--ink);
				text-decoration: none;
				transition:
					border-color 180ms ease,
					background-color 180ms ease;
			}

			.drawer-icon svg {
				display: block;
				width: 26px;
				height: 26px;
			}

			/* LINE keeps its own colour so the channel is recognisable at a
			   glance; the fill is the darkened green that clears AA. */
			.drawer-icon.is-line {
				background: var(--line-fill);
				border-color: transparent;
				color: #fff;
			}

			@media (hover: hover) {
				.drawer-icon:hover {
					border-color: var(--ink);
					background: var(--tint-honey);
				}

				.drawer-icon.is-line:hover {
					background: var(--line-fill-dark);
					border-color: transparent;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.drawer-icon {
					transition: none;
				}
			}

			/* ---- footer: cocoa band ---- */

			/* No top margin: when a cocoa .band ends main, a beige gap between it
			   and the cocoa footer read as two disconnected slabs. Flush, with a
			   hairline divider, they close the page as one block. Pages that end
			   on cream simply meet the footer directly, which is normal. */
			.site-foot {
				margin-top: 0;
				background: var(--cocoa);
				color: rgba(255, 249, 237, 0.82);
				border-top: 1px solid rgba(255, 249, 237, 0.18);
			}

			/* When the page carries a full CTA band, the footer's own LINE button
			   is a third identical call to action in one screen. Deliberately not
			   :last-child: the SEO zone sits after the band on the home page, and
			   the redundancy argument holds regardless of what follows.
			   Without :has() support both simply show, which is not a defect. */
			main:has(> section.band) + .site-foot .foot-cta {
				display: none;
			}

			.foot-inner {
				display: grid;
				gap: 2.5rem;
				padding-block: 3rem 3.5rem;
			}

			.foot-mark {
				display: flex;
				align-items: center;
				/* 0.1389 x mark size, matching the lockup's own spacing. */
				gap: 0.3125rem;
				line-height: 1;
				color: var(--cream);
			}

			/* 0.7551 x mark size, again from the lockup geometry. */
			.foot-wordmark {
				display: block;
				height: 1.6875rem;
				width: auto;
			}

			/* The mark sits on cocoa, never on a honey-adjacent surface. */
			.foot-bear {
				display: block;
				width: 2.25rem;
				height: 2.25rem;
				flex: none;
			}

			.foot-note {
				color: rgba(255, 249, 237, 0.72);
				font-size: var(--fs-body-sm);
				max-width: 26rem;
			}

			.foot-nav {
				margin-top: 1.25rem;
			}

			.foot-nav ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
			}

			.foot-nav a {
				color: rgba(255, 249, 237, 0.86);
				font-size: var(--fs-body-sm);
				text-decoration: none;
				border-bottom: 1px solid rgba(255, 249, 237, 0.28);
				padding-bottom: 0.125rem;
			}

			.foot-nav a:hover {
				color: #fff;
				border-bottom-color: #fff;
			}

			.foot-cta {
				display: grid;
				gap: 0.875rem;
				justify-items: start;
				align-content: start;
			}

			.foot-cta-label {
				font-family: var(--font-head);
				font-weight: 500;
				font-size: var(--fs-body);
				color: #fff;
			}

			@media (min-width: 48em) {
				.foot-inner {
					grid-template-columns: 1fr auto;
					gap: 3.5rem;
					padding-block: 4rem 4.5rem;
				}

				/* With the CTA column hidden the row would otherwise keep an empty
				   auto track. */
				main:has(> section.band)
					+ .site-foot
					.foot-inner {
					grid-template-columns: 1fr;
				}
			}

			/* ---- section bands ---- */

			.section {
				padding-block: 3.5rem;
			}

			@media (min-width: 48em) {
				.section {
					padding-block: 5.5rem;
				}
			}

			/* Full-bleed colour comes from the section's own background with the
			   shell inside. Never 100vw: that counts the scrollbar and brings
			   back horizontal scroll. */
			/* --paper and --cream are the same value in this palette, so the
			   warmer honey-washed tone carries the alternation instead. */
			.band-cream {
				background: var(--warm);
			}

			.band-tint {
				background: var(--tint);
			}

			.section-head {
				display: grid;
				gap: 0.75rem;
				max-width: 42rem;
				margin-bottom: 2.5rem;
			}

			.section-head h2 {
				font-size: var(--fs-h2);
			}

			.lede {
				color: var(--muted);
				max-width: 34rem;
			}

			/* ---- buttons ---- */

			.cta-quiet {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-head);
				font-weight: 500;
				font-size: var(--fs-body);
				line-height: 1.4;
				padding: 0.8125rem 1.375rem;
				border-radius: 12px;
				background: var(--paper);
				color: var(--accent);
				text-decoration: none;
				border: 1px solid var(--rule);
				transition:
					transform 180ms ease,
					box-shadow 180ms ease,
					border-color 180ms ease;
			}

			@media (hover: hover) {
				.cta-quiet:hover {
					border-color: var(--accent);
					transform: translateY(-2px);
					box-shadow: var(--shadow-sm);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.cta-quiet {
					transition: none;
				}

				.cta-quiet:hover {
					transform: none;
				}
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem;
			}

			/* ---- inner page header ---- */

			.page-head-inner {
				display: grid;
				gap: 1rem;
				padding-block: 3rem 3.5rem;
				max-width: 44rem;
			}

			.page-head h1 {
				font-size: var(--fs-h1);
				text-wrap: balance;
			}

			@media (min-width: 48em) {
				.page-head-inner {
					padding-block: 4.5rem 5rem;
				}
			}

			/* ---- numbered steps, shared by / and /contact ---- */

			.steps {
				display: grid;
				gap: 1rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.step {
				display: grid;
				/* minmax(0,1fr) so the text column can shrink below its
				   min-content width; a bare 1fr floors at min-content and any
				   unbreakable run pushes the card past the viewport. */
				grid-template-columns: auto minmax(0, 1fr);
				gap: 0 1rem;
				align-items: start;
				padding: 1.25rem;
				border-radius: var(--radius);
				background: var(--paper);
				border: 1px solid var(--rule-soft);
				box-shadow: var(--shadow-sm);
				transition:
					transform 200ms ease,
					box-shadow 200ms ease;
			}

			@media (hover: hover) {
				.step:hover {
					transform: translateY(-3px);
					box-shadow: var(--shadow-md);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.step {
					transition: none;
				}

				.step:hover {
					transform: none;
				}
			}

			.step-mark {
				display: grid;
				grid-template-columns: auto auto;
				align-items: center;
				gap: 0.625rem;
			}

			/* No opacity: accent at 0.7 measured 4.10:1, under AA. Full accent on
			   the card background is 9.08:1. */
			.step-n {
				font-family: var(--font-head);
				font-weight: 600;
				font-size: var(--fs-label);
				letter-spacing: 0;
				color: var(--honey-ink);
				font-variant-numeric: tabular-nums;
			}

			.step-body {
				display: grid;
				gap: 0.375rem;
				min-width: 0;
			}

			.step-body h3 {
				font-size: var(--fs-subtitle);
				font-weight: 600;
			}

			.step-body p {
				color: var(--muted);
				font-size: var(--fs-body-sm);
				max-width: 38rem;
			}

			@media (min-width: 48em) {
				.steps {
					grid-template-columns: repeat(2, 1fr);
					gap: 1.25rem;
				}

				.step {
					padding: 1.75rem;
				}
			}

			/* ---- closing note under a section ---- */

			.more {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--rule);
				color: var(--muted);
				font-size: var(--fs-body-sm);
			}

			/* ---- FAQ accordion (shared by /contact and /fix-ai-website) ----
			   Native details/summary: opens without JS. One pattern site-wide;
			   an earlier flat-article variant on /fix-ai-website also broke the
			   heading outline with sibling h2s under the section h2. */
			.faq {
				display: grid;
				gap: 0.75rem;
			}

			.faq-item {
				border-radius: var(--radius);
				background: var(--paper);
				border: 1px solid var(--rule-soft);
				box-shadow: var(--shadow-sm);
				overflow: hidden;
			}

			.faq-item summary {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				min-height: 44px;
				padding: 1rem 1.25rem;
				cursor: pointer;
				list-style: none;
				font-family: var(--font-head);
				font-weight: 500;
				font-size: var(--fs-body);
				color: var(--ink);
			}

			.faq-item summary::-webkit-details-marker {
				display: none;
			}

			.faq-q {
				flex: 1;
				min-width: 0;
			}

			/* Plus turning into a minus, drawn in CSS rather than as a glyph. */
			.faq-sign {
				position: relative;
				width: 1rem;
				height: 1rem;
				flex: none;
			}

			.faq-sign::before,
			.faq-sign::after {
				content: "";
				position: absolute;
				left: 50%;
				top: 50%;
				width: 0.875rem;
				height: 2px;
				border-radius: 2px;
				background: var(--accent);
				transform: translate(-50%, -50%);
				transition: transform 240ms ease;
			}

			.faq-item[open] .faq-sign::after {
				transform: translate(-50%, -50%) rotate(0deg);
			}

			.faq-sign::after {
				transform: translate(-50%, -50%) rotate(90deg);
			}

			/* Thai reads comfortably on a shorter measure than Latin. */
			.faq-a {
				padding: 0 1.25rem 1.25rem;
				color: var(--muted);
				font-size: var(--fs-body-sm);
				max-width: 32rem;
			}

			@media (hover: hover) {
				.faq-item summary:hover {
					background: var(--tint);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.faq-sign::before,
				.faq-sign::after {
					transition: none;
				}
			}

			@media (min-width: 48em) {
				.faq-item summary {
					padding: 1.125rem 1.5rem;
					font-size: var(--fs-body);
				}

				.faq-a {
					padding: 0 1.5rem 1.5rem;
				}
			}

			/* ---- work cards ---- */

			.work-list {
				display: grid;
				gap: 1.75rem;
			}

			.work-item {
				display: grid;
				gap: 1rem;
				align-content: start;
				padding: 1rem;
				border-radius: var(--radius);
				background: var(--paper);
				border: 1px solid var(--rule-soft);
				box-shadow: var(--shadow-sm);
				transition:
					transform 220ms ease,
					box-shadow 220ms ease;
			}

			@media (hover: hover) {
				.work-item:hover {
					transform: translateY(-4px);
					box-shadow: var(--shadow-md);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.work-item {
					transition: none;
				}

				.work-item:hover {
					transform: none;
				}
			}

			.work-item h3 {
				font-size: var(--fs-subtitle);
				font-weight: 600;
				overflow-wrap: anywhere;
			}

			.work-item p {
				color: var(--muted);
				font-size: var(--fs-body-sm);
			}

			/* Coloured kind tag, one tint per project. */
			.tag {
				display: inline-flex;
				align-items: center;
				align-self: start;
				padding: 0.3125rem 0.75rem;
				border-radius: 999px;
				font-family: var(--font-head);
				font-weight: 500;
				font-size: var(--fs-label);
				letter-spacing: 0;
				background: var(--tint-strong);
				color: var(--accent);
			}

			.tag.is-amber {
				background: var(--tint-honey);
				color: var(--honey-ink);
			}

			.tag.is-clay {
				background: var(--tint-scarf);
				color: var(--scarf-ink);
			}

			.work-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4375rem;
				align-self: start;
				font-family: var(--font-head);
				font-weight: 500;
				font-size: var(--fs-body-sm);
				text-decoration: none;
				border-bottom: 1px solid transparent;
				padding-bottom: 0.0625rem;
			}

			.work-link:hover {
				border-bottom-color: var(--accent);
			}

			.work-link .icon {
				transition: transform 200ms ease;
			}

			@media (hover: hover) {
				.work-item:hover .work-link .icon {
					transform: translate(2px, -2px);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.work-link .icon {
					transition: none;
				}
			}

			/* ---- contact band, shared ---- */

			.band {
				background: var(--cocoa);
				color: rgba(255, 249, 237, 0.86);
			}

			.band-inner {
				display: grid;
				gap: 1.25rem;
				padding-block: 3.25rem;
				max-width: 42rem;
			}

			.band-inner h2 {
				font-size: var(--fs-h2);
				color: #fff;
			}

			.band-inner .label {
				color: rgba(255, 249, 237, 0.86);
			}

			.band-inner .label::before {
				background: rgba(255, 249, 237, 0.7);
			}

			.band-inner .lede {
				color: rgba(255, 249, 237, 0.78);
			}

			.band-inner .actions {
				margin-top: 0.5rem;
			}

			.band-inner .cta-quiet {
				background: transparent;
				color: #fff;
				border-color: rgba(255, 249, 237, 0.42);
			}

			@media (hover: hover) {
				.band-inner .cta-quiet:hover {
					border-color: #fff;
					background: rgba(255, 249, 237, 0.08);
				}
			}

			@media (min-width: 48em) {
				.band-inner {
					padding-block: 4.5rem;
				}
			}

			/* ---- back to top ---- */

			.back-to-top {
				position: fixed;
				right: max(1rem, env(safe-area-inset-right));
				bottom: max(1rem, env(safe-area-inset-bottom));
				z-index: 9;
				display: grid;
				place-items: center;
				width: 2.875rem;
				height: 2.875rem;
				padding: 0;
				border: 1px solid var(--rule);
				border-radius: 50%;
				background: var(--paper);
				box-shadow: var(--shadow-md);
				color: var(--ink);
				font-family: var(--font-head);
				font-size: var(--fs-label);
				cursor: pointer;
				opacity: 0;
				pointer-events: none;
				transform: translateY(0.75rem);
				transition: opacity 180ms ease, transform 180ms ease, background-color 180ms ease;
			}

			.back-to-top.is-visible {
				opacity: 1;
				pointer-events: auto;
				transform: translateY(0);
			}

			.back-to-top svg {
				width: 1rem;
				height: 1rem;
			}

			@media (hover: hover) {
				.back-to-top:hover {
					background: var(--tint-strong);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.back-to-top {
					transition: none;
				}
			}
		</style>
	</body>
</html>
