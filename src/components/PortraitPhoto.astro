---
/**
 * The owner's portrait, as a responsive <picture>.
 *
 * WHY THIS IS NOT ImagePlaceholder: `astro.config.mjs` runs
 * `passthroughImageService()`, so Astro emits every image byte-identical to
 * its source. `ImagePlaceholder` accepts `widths` and `sizes` props but
 * `AssetImage` renders a plain <img> with no srcset, so under passthrough
 * neither prop does anything. A 2.2MB portrait shipped that way would be
 * downloaded in full by a phone painting it at 300px wide.
 *
 * The variants are pre-generated by `scripts/build-portrait.mjs` and imported
 * here so Astro content-hashes and long-caches them. Re-run that script after
 * replacing `public/me.png`.
 *
 * AVIF is listed before WebP so a browser that decodes it takes the smaller
 * file; the <img> keeps a WebP src as the universal fallback.
 */

import me320avif from "../assets/images/portrait/me-320.avif";
import me480avif from "../assets/images/portrait/me-480.avif";
import me640avif from "../assets/images/portrait/me-640.avif";
import me760avif from "../assets/images/portrait/me-760.avif";
import me320webp from "../assets/images/portrait/me-320.webp";
import me480webp from "../assets/images/portrait/me-480.webp";
import me640webp from "../assets/images/portrait/me-640.webp";
import me760webp from "../assets/images/portrait/me-760.webp";

interface Props {
	/** Descriptive alt text in the page's own language. Kept raw, never run
	    through ThaiText, so it remains untouched machine-readable text. */
	alt: string;
	/** Rendered-width hint. Required: without it the browser assumes 100vw and
	    picks a larger file than the layout will ever paint. */
	sizes: string;
	/** Below the fold on both home pages, so lazy is the right default. */
	loading?: "lazy" | "eager";
	class?: string;
}

const { alt, sizes, loading = "lazy", class: className } = Astro.props;

const avif = [me320avif, me480avif, me640avif, me760avif];
const webp = [me320webp, me480webp, me640webp, me760webp];

const srcset = (set: typeof avif) =>
	set.map((image) => `${image.src} ${image.width}w`).join(", ");

const fallback = webp[webp.length - 1];
---

<picture class:list={["portrait", className]}>
	<source type="image/avif" srcset={srcset(avif)} sizes={sizes} />
	<source type="image/webp" srcset={srcset(webp)} sizes={sizes} />
	<img
		src={fallback.src}
		width={fallback.width}
		height={fallback.height}
		alt={alt}
		loading={loading}
		decoding="async"
	/>
</picture>

<style>
	.portrait,
	.portrait img {
		display: block;
		width: 100%;
		height: auto;
	}

	.portrait img {
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
		/* The same hairline that separates every card on the site, so the
		   portrait sits inside the system rather than beside it. */
		border: 1px solid var(--rule-soft);
	}
</style>
