---
import AssetImage from "./AssetImage.astro";
import badgeImage from "../assets/images/icons/3d/badge.png";
import careImage from "../assets/images/icons/3d/care.png";
import clockImage from "../assets/images/icons/3d/clock.png";
import deliverImage from "../assets/images/icons/3d/deliver.png";
import factoryImage from "../assets/images/icons/3d/factory.png";
import flowImage from "../assets/images/icons/3d/flow.png";
import helpImage from "../assets/images/icons/3d/help.png";
import listenImage from "../assets/images/icons/3d/listen.png";
import plainwordsImage from "../assets/images/icons/3d/plainwords.png";
import projectsImage from "../assets/images/icons/3d/projects.png";
import scopeImage from "../assets/images/icons/3d/scope.png";
import sparkImage from "../assets/images/icons/3d/spark.png";
import storefrontImage from "../assets/images/icons/3d/storefront.png";
import updatesImage from "../assets/images/icons/3d/updates.png";

/**
 * Clay image assets for explanatory content, with compact hand-drawn SVGs
 * retained for navigation affordances. All are decorative because each sits
 * beside its own Thai label.
 */
interface Props {
	name: keyof typeof paths;
	size?: number;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	class?: string;
}

const paths = {
	// storefront / browser window: business website
	storefront: `
		<path d="M3.5 9.5 5 4.5h14l1.5 5" />
		<path d="M4.5 9.5v9a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-9" />
		<path d="M3.5 9.5a2.6 2.6 0 0 0 4.1 2 2.6 2.6 0 0 0 4.4 0 2.6 2.6 0 0 0 4.4 0 2.6 2.6 0 0 0 4.1-2" />
		<path d="M9.5 20v-5h5v5" />
	`,
	// connected boxes: scattered work becoming one shared system
	flow: `
		<rect x="3" y="3.75" width="6.5" height="5.5" rx="1.5" />
		<rect x="14.5" y="3.75" width="6.5" height="5.5" rx="1.5" />
		<rect x="8.75" y="14.75" width="6.5" height="5.5" rx="1.5" />
		<path d="M6.25 9.25v2.25a1.5 1.5 0 0 0 1.5 1.5h1.75" />
		<path d="M17.75 9.25v2.25a1.5 1.5 0 0 1-1.5 1.5H14.5" />
		<path d="M12 13v1.75" />
	`,
	// wrench + refresh: care and improvement after handover
	care: `
		<path d="M14.9 6.35a3.4 3.4 0 0 0 4.3 4.3l1.55 1.55a1.4 1.4 0 0 1 0 2l-1.45 1.45a1.4 1.4 0 0 1-2 0L6.35 4.8a1.4 1.4 0 0 1 0-2L7.8 1.35" transform="translate(0 2.2)" />
		<path d="M6.6 20.4a2.2 2.2 0 1 0-2.2-2.2" />
		<path d="M4.4 15.6v2.6H7" />
	`,
	// ear / listening: hearing the problem first
	listen: `
		<path d="M7.5 9a4.5 4.5 0 0 1 9 0c0 2.2-1.4 3.1-2.4 4.1-.8.8-1.1 1.6-1.1 2.6a2.3 2.3 0 0 1-4.6 0" />
		<path d="M10.4 9a1.7 1.7 0 0 1 3.3 0" />
		<path d="M12 3.5a8.5 8.5 0 0 0-8.5 8.5" />
	`,
	// checklist: scope written down and agreed
	scope: `
		<rect x="4" y="3.25" width="16" height="17.5" rx="2.5" />
		<path d="M8 8.75h8" />
		<path d="M8 12.5h8" />
		<path d="M8 16.25h5" />
	`,
	// progress dots along a line: regular updates.
	// The line is drawn in three segments that stop at each circle's edge
	// (ink spans 4.9-9.1 and 14.9-19.1); a single full-width line would run
	// straight through both dots and read as crossed out.
	updates: `
		<path d="M3.5 12h1.4" />
		<path d="M9.1 12h5.8" />
		<path d="M19.1 12h1.4" />
		<circle cx="7" cy="12" r="2.1" />
		<circle cx="17" cy="12" r="2.1" />
		<path d="M7 9.9V6.5" />
		<path d="M17 14.1v3.4" />
	`,
	// package with a tick: delivered ready to use
	deliver: `
		<path d="M20.5 8.6v6.8a1.6 1.6 0 0 1-.85 1.4l-6.85 3.7a1.6 1.6 0 0 1-1.6 0l-6.85-3.7a1.6 1.6 0 0 1-.85-1.4V8.6" />
		<path d="M3.9 8 11.2 4a1.6 1.6 0 0 1 1.6 0L20.1 8a.7.7 0 0 1 0 1.2l-7.3 4a1.6 1.6 0 0 1-1.6 0l-7.3-4a.7.7 0 0 1 0-1.2Z" />
		<path d="M9.6 15.1l1.7 1.6 3.2-3.2" />
	`,
	// question in a bubble: what you want help with
	help: `
		<path d="M20.5 11.4a7.9 7.9 0 0 1-8.5 7.85 9 9 0 0 1-1.9-.25L5.4 20.6a.6.6 0 0 1-.78-.72l.95-3.4A7.6 7.6 0 0 1 3.5 11.4C3.5 7 7.3 3.5 12 3.5s8.5 3.5 8.5 7.9Z" />
		<path d="M10.2 9.5a1.85 1.85 0 0 1 3.6.6c0 1.25-1.8 1.6-1.8 2.85" />
		<path d="M12 15.4h.01" />
	`,
	// clock: timeframe
	clock: `
		<circle cx="12" cy="12" r="8.5" />
		<path d="M12 7.2V12l3.1 1.9" />
	`,
	// badge: former team credential
	badge: `
		<path d="M12 3.5 14.1 6l3.35-.5.4 3.35 2.8 1.9-1.75 2.9 1.75 2.9-2.8 1.9-.4 3.35L14.1 21 12 20.5" transform="translate(0 -0.75)" />
		<path d="M12 3.5 9.9 6l-3.35-.5-.4 3.35-2.8 1.9 1.75 2.9-1.75 2.9 2.8 1.9.4 3.35L9.9 21l2.1-.5" transform="translate(0 -0.75)" />
		<path d="M9.4 11.9l1.9 1.85 3.4-3.4" />
	`,
	// spark: building own products
	spark: `
		<path d="M12 3.5 13.7 9l5.5 1.7-5.5 1.7L12 17.9l-1.7-5.5L4.8 10.7 10.3 9 12 3.5Z" />
		<path d="M18.5 16.2l.7 2.1 2.1.7-2.1.7-.7 2.1-.7-2.1-2.1-.7 2.1-.7.7-2.1Z" />
	`,
	// speech bubbles: plain language
	plainwords: `
		<path d="M17.5 13.4a1.9 1.9 0 0 1-1.9 1.9H8.4L4.6 18.6V6.4a1.9 1.9 0 0 1 1.9-1.9h9.2a1.9 1.9 0 0 1 1.9 1.9Z" />
		<path d="M8.2 8.4h5.6" />
		<path d="M8.2 11.4h3.4" />
	`,
	// order sheet with a checked status
	orders: `
		<rect x="4" y="3.5" width="16" height="17" rx="2.5" />
		<path d="M8 8h5" />
		<path d="M8 12h3" />
		<path d="m14.5 15.2 1.5 1.5 3-3" />
	`,
	// stacked boxes: products and stock movement
	inventory: `
		<path d="m4 7.2 8-3.7 8 3.7-8 3.7-8-3.7Z" />
		<path d="M4 7.2v9.5l8 3.8 8-3.8V7.2" />
		<path d="M12 10.9v9.6" />
		<path d="m8.2 5.2 8 3.7" />
	`,
	// two customer profiles sharing one record
	customers: `
		<circle cx="9" cy="8" r="3" />
		<path d="M3.8 19c.4-3.4 2.2-5.2 5.2-5.2s4.8 1.8 5.2 5.2" />
		<circle cx="17" cy="9" r="2.2" />
		<path d="M15.3 14.2c3.2-.8 5.2.8 5.5 3.8" />
	`,
	// people around a shared task
	teamwork: `
		<circle cx="7" cy="7" r="2.4" />
		<circle cx="17" cy="7" r="2.4" />
		<path d="M3.5 16.8c.3-3 1.5-4.6 3.5-4.6s3.2 1.6 3.5 4.6" />
		<path d="M13.5 16.8c.3-3 1.5-4.6 3.5-4.6s3.2 1.6 3.5 4.6" />
		<path d="M9.5 19.5h5" />
	`,
	// simple owner report, without decorative metrics
	report: `
		<rect x="3.5" y="4" width="17" height="16" rx="2.5" />
		<path d="M7.5 16v-3" />
		<path d="M12 16V9" />
		<path d="M16.5 16v-5" />
	`,
	// one target: start with the most painful point
	focus: `
		<circle cx="12" cy="12" r="8.5" />
		<circle cx="12" cy="12" r="4.5" />
		<circle cx="12" cy="12" r="1" />
	`,
	// three work streams resolving into one shared view
	overview: `
		<path d="M4 5.5h5v5H4z" />
		<path d="M15 5.5h5v5h-5z" />
		<path d="M9.5 15h5v5h-5z" />
		<path d="M6.5 10.5v2h11v-2" />
		<path d="M12 12.5V15" />
	`,
	// factory roofline and chimney
	factory: `
		<path d="M3.5 20V9.5l5 3v-3l5 3v-7h4v9" />
		<path d="M3.5 20h17V12l-7 4" />
		<path d="M7 17h2" />
		<path d="M12 17h2" />
	`,
	// cafe cup paired with a leaf for farm cafes
	cafe: `
		<path d="M5 9h12v5.5a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5V9Z" />
		<path d="M17 11h1.2a2.3 2.3 0 0 1 0 4.6h-1.7" />
		<path d="M9 6.5c.2-2 1.4-3 3.5-3-0.1 2-1.3 3-3.5 3Z" />
	`,
	// hotel building and reception door
	hotel: `
		<path d="M5 20V5.5A1.5 1.5 0 0 1 6.5 4h11A1.5 1.5 0 0 1 19 5.5V20" />
		<path d="M3.5 20h17" />
		<path d="M8 8h2" />
		<path d="M14 8h2" />
		<path d="M8 12h2" />
		<path d="M14 12h2" />
		<path d="M10 20v-4h4v4" />
	`,
	// wholesale cartons moving together
	wholesale: `
		<path d="m4 7 5-2.5L14 7l-5 2.5L4 7Z" />
		<path d="M4 7v6l5 2.5 5-2.5V7" />
		<path d="m13 11 3-1.5 4 2-4 2-3-1.5" />
		<path d="M16 13.5V19l4-2v-5.5" />
		<path d="M13 15.5 16 17" />
	`,
	// hard hat for project and site work
	construction: `
		<path d="M4 15.5a8 8 0 0 1 16 0" />
		<path d="M3.5 15.5h17v2.2a1.3 1.3 0 0 1-1.3 1.3H4.8a1.3 1.3 0 0 1-1.3-1.3v-2.2Z" />
		<path d="M9 7.1v5.4" />
		<path d="M15 7.1v5.4" />
	`,
	// candidate profile moving through a hiring path
	recruitment: `
		<circle cx="8" cy="8" r="3" />
		<path d="M3.5 18c.4-3.4 1.9-5.2 4.5-5.2s4.1 1.8 4.5 5.2" />
		<path d="M14 8h6" />
		<path d="m17.5 5.5 2.5 2.5-2.5 2.5" />
		<path d="M15 15h5" />
	`,
	// sprout rows: farms and food production
	farm: `
		<path d="M12 20V9" />
		<path d="M12 11c-4.2 0-6.5-2-6.5-5.5C9.5 5.5 12 7 12 11Z" />
		<path d="M12 14c4.2 0 6.5-2 6.5-5.5-4 0-6.5 1.5-6.5 5.5Z" />
		<path d="M4 20h16" />
	`,
	// durian on the branch: spiked shell drawn as a ring of short strokes
	orchard: `
		<path d="M12 4.5V7" />
		<path d="M12 20a6.5 6.5 0 0 0 0-13 6.5 6.5 0 0 0 0 13Z" />
		<path d="M12 7 10 5" />
		<path d="m6.9 9.4-2.4-.8" />
		<path d="m6.6 15.2-2.3 1" />
		<path d="m17.1 9.4 2.4-.8" />
		<path d="m17.4 15.2 2.3 1" />
	`,
	// rice grain over the mill's stacked silo rings
	mill: `
		<path d="M12 3.5c1.8 1.6 2.6 3.2 2.6 4.8S13.8 11.5 12 12.6c-1.8-1.1-2.6-2.7-2.6-4.3S10.2 5.1 12 3.5Z" />
		<path d="M5.5 20v-4.6l6.5-2.8 6.5 2.8V20" />
		<path d="M3.5 20h17" />
		<path d="M5.5 17.4h13" />
	`,
	// crane arm over a footing: ground-up construction
	building: `
		<path d="M4.5 20V4.5h9" />
		<path d="M4.5 8h9" />
		<path d="M13.5 4.5h6" />
		<path d="M16.5 4.5v3.2" />
		<path d="M14.6 7.7h3.8l-.7 3h-2.4l-.7-3Z" />
		<path d="M3 20h18" />
	`,
	// handshake over a key: brokered deals rather than owned property
	broker: `
		<path d="M3.5 12.5h3l2.5 2.2 2 .3" />
		<path d="M11 15h2.5l3 2.5" />
		<path d="M14 9.5h3.5l3 2" />
		<path d="M13.5 9.5 11 7.6 8.5 9.4a1.6 1.6 0 0 0 2 2.4l1-.8" />
		<circle cx="18" cy="6.5" r="2" />
	`,
	// delivery vehicle and route point
	logistics: `
		<path d="M3.5 6h11v10h-11V6Z" />
		<path d="M14.5 10h3l3 3v3h-6" />
		<circle cx="7" cy="18" r="2" />
		<circle cx="17" cy="18" r="2" />
	`,
	// building with a location marker
	property: `
		<path d="M4.5 20V6h9v14" />
		<path d="M7.5 9h3" />
		<path d="M7.5 13h3" />
		<path d="M7.5 17h2" />
		<path d="M16.5 14.5c-1.8 0-3-1.2-3-3s1.2-3 3-3 3 1.2 3 3c0 2.2-3 5.5-3 5.5s-3-3.3-3-5.5" />
	`,
	// care cross held by a soft heart outline
	wellness: `
		<path d="M12 20S4 15.4 4 9.6A4.1 4.1 0 0 1 11.2 7L12 8l.8-1A4.1 4.1 0 0 1 20 9.6C20 15.4 12 20 12 20Z" />
		<path d="M12 10v5" />
		<path d="M9.5 12.5h5" />
	`,
	// signed collaboration agreement
	contract: `
		<path d="M5 3.5h10l4 4V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z" />
		<path d="M15 3.5v4h4" />
		<path d="M8 12h7" />
		<path d="M8 15h4" />
		<path d="m13.5 18 1.4 1.3 2.6-2.6" />
	`,
	// arrow right: inline "go" affordance
	arrow: `
		<path d="M4.5 12h14" />
		<path d="M13 6.5 18.5 12 13 17.5" />
	`,
	// external link: opens the live site
	external: `
		<path d="M13.75 4.5h5.75v5.75" />
		<path d="M19.5 4.5 11 13" />
		<path d="M18 14.4v4.1a1.6 1.6 0 0 1-1.6 1.6H5.5a1.6 1.6 0 0 1-1.6-1.6V7.6A1.6 1.6 0 0 1 5.5 6h4.1" />
	`,
} as const;

const imageAssets: Partial<Record<keyof typeof paths, ImageMetadata>> = {
	storefront: storefrontImage,
	flow: flowImage,
	care: careImage,
	listen: listenImage,
	scope: scopeImage,
	updates: updatesImage,
	deliver: deliverImage,
	help: helpImage,
	clock: clockImage,
	badge: badgeImage,
	spark: sparkImage,
	plainwords: plainwordsImage,
	orders: scopeImage,
	inventory: deliverImage,
	customers: plainwordsImage,
	teamwork: flowImage,
	report: updatesImage,
	focus: sparkImage,
	overview: flowImage,
	factory: factoryImage,
	cafe: storefrontImage,
	hotel: storefrontImage,
	wholesale: deliverImage,
	construction: projectsImage,
	recruitment: plainwordsImage,
	farm: factoryImage,
	logistics: updatesImage,
	building: projectsImage,
	broker: projectsImage,
	property: storefrontImage,
	wellness: careImage,
	contract: scopeImage,
};

const {
	name,
	size = 24,
	loading = "lazy",
	fetchpriority,
	class: className,
} = Astro.props;
const imageAsset = imageAssets[name];
// Raster icons fill the shared 4rem chip via CSS. Generate for that rendered
// size rather than the smaller legacy SVG size prop, which would be upscaled.
const rasterSize = 64;
---

{
	imageAsset ? (
		<AssetImage
			class:list={["icon", "icon-image", className]}
			src={imageAsset}
			width={rasterSize}
			height={rasterSize}
			alt=""
			aria-hidden="true"
			loading={loading}
			fetchpriority={fetchpriority}
			decoding="async"
		/>
	) : (
		<svg
			class:list={["icon", className]}
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
			set:html={paths[name]}
		/>
	)
}

<style>
	.icon {
		display: block;
		flex: none;
	}

	.icon-image {
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter: drop-shadow(0 0.125rem 0.1875rem rgba(51, 36, 26, 0.14));
	}
</style>
