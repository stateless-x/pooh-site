---
/**
 * The LINE call to action, in LINE's own button treatment: brand green with a
 * white label and the messenger speech-bubble mark. Thai visitors recognise
 * this instantly, which is most of the trust work on the page.
 *
 * The bubble is hand-drawn here rather than using a downloaded brand asset.
 * It is the plain bubble mark, with no lettering inside: small lettering would
 * misrender at button size and would put Latin text inside an SVG.
 */
import { LINE_ID, LINE_URL } from "../../site.config.mjs";

interface Props {
	label?: string;
	/** "lg" for the hero and contact centrepiece, "md" elsewhere. */
	size?: "md" | "lg";
	class?: string;
}

const {
	label = `ทักไลน์: ${LINE_ID}`,
	size = "md",
	class: className,
} = Astro.props;
---

<a
	class:list={["line-btn", `is-${size}`, className]}
	href={LINE_URL}
>
	<span class="line-mark" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none" focusable="false">
			<path
				d="M12 3.2c-5 0-9 3.2-9 7.2 0 3.6 3 6.6 7.1 7.1.3.06.6.2.7.4.1.2.06.5.03.7l-.1.7c-.04.2-.2.9.7.5s4.9-2.9 6.7-5c1.2-1.3 1.8-2.7 1.8-4.4 0-4-4-7.2-9-7.2Z"
				fill="currentColor"></path>
		</svg>
	</span>
	<span class="line-label">{label}</span>
</a>

<style>
	.line-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.8125rem 1.375rem;
		border-radius: 12px;
		background: var(--line-fill);
		color: #fff;
		font-family: var(--font-head);
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.4;
		text-decoration: none;
		border: 1px solid rgba(0, 0, 0, 0.06);
		box-shadow: 0 2px 6px rgba(4, 137, 63, 0.3);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			background-color 180ms ease;
	}

	.is-lg {
		padding: 1rem 1.75rem;
		font-size: 1.0625rem;
		gap: 0.75rem;
	}

	.line-mark {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		color: #fff;
	}

	.is-lg .line-mark {
		width: 1.75rem;
		height: 1.75rem;
	}

	.line-mark svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* No nowrap: a longer Thai label (e.g. the conversion CTA) cannot fit one
	   line at 320px and would push the button past the viewport. */
	.line-label {
		min-width: 0;
	}

	@media (hover: hover) {
		.line-btn:hover {
			background: var(--line-fill-dark);
			transform: translateY(-2px);
			box-shadow: 0 8px 18px rgba(4, 137, 63, 0.34);
		}
	}

	.line-btn:active {
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.line-btn {
			transition: none;
		}

		.line-btn:hover {
			transform: none;
		}
	}
</style>
