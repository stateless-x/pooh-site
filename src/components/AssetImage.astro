---
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	width?: number | string;
	height?: number | string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	decoding?: "sync" | "async" | "auto";
	class?: string;
	"aria-hidden"?: boolean | "true" | "false";
}

const {
	src,
	alt,
	width = src.width,
	height = src.height,
	loading = "lazy",
	fetchpriority,
	decoding = "async",
	class: className,
	"aria-hidden": ariaHidden,
} = Astro.props;
---

<img
	src={src.src}
	alt={alt}
	width={width}
	height={height}
	loading={loading}
	fetchpriority={fetchpriority}
	decoding={decoding}
	class={className}
	aria-hidden={ariaHidden}
/>
